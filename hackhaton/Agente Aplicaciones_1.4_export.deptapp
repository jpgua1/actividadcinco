On":"","redrawOn":"","labelPosition":"top","errorLabel":"","hideLabel":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"dataGridLabel":true,"id":"esd7jlj"},{"label":"recargar","showValidations":false,"tableView":false,"key":"recargar","type":"button","input":true,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"size":"md","leftIcon":"","rightIcon":"","block":false,"action":"submit","disableOnInvalid":false,"theme":"primary","dataGridLabel":true,"id":"es27tgp"},{"label":"\uD83D\uDCE5 Descargar Archivo ZIP","showValidations":true,"tableView":false,"key":"submit","type":"button","input":true,"customClass":"btn btn-primary","theme":"primary","action":"submit","size":"lg","block":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"hideLabel":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"disableOnInvalid":false,"dataGridLabel":true,"id":"epuaxvo","leftIcon":"","rightIcon":""},{"label":"Volver","action":"submit","showValidations":false,"theme":"primary","size":"md","block":false,"leftIcon":"","rightIcon":"","shortcut":"","description":"","tooltip":"","customClass":"","tabindex":"","disableOnInvalid":false,"hidden":false,"autofocus":false,"disabled":false,"tableView":false,"modalEdit":false,"key":"volver","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"button","input":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","errorLabel":"","hideLabel":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"dataGridLabel":true,"id":"edb3bqm"}],"outputs":6,"x":100,"y":100,"wires":[["e16a61e0.ac0058"],["511dd34c.2bdd14"],["30d99c73.a7ac94"],["8016a97f.8b5e1"],["a7a94146.c9f58"],["f3e8da2.a7fc028"]]},{"id":"a7a94146.c9f58","type":"axetflows-view-action","z":"ef48fe5e.6a89","name":"","action":"redirect","redirectPage":"af85aade.cc55e8","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":370,"y":300,"wires":[]},{"id":"30d99c73.a7ac94","type":"function","z":"ef48fe5e.6a89","name":"recargar","func":"// You can use lodash@4.17.15 through the object keyword '_'\n// for example _.isEmpty(var) - https://lodash.com/docs/4.17.15\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node,\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\nmsg.submission = {\n    job_id: msg.payload.data.job_id,\n    inventory: msg.payload.data.inventory,\n    download_url: msg.payload.data.download_url,\n    projectPath: msg.payload.data.projectPath\n}\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":420,"y":160,"wires":[["431f856b.459a24"]]},{"id":"37070941.b83876","type":"function","z":"ef48fe5e.6a89","name":"Mostrar análisis","func":"const uploadResponse = msg.payload;\nconst axios = global.get('axios') || require('axios');\n\nnode.warn('\uD83D\uDCE5 Upload response: ' + JSON.stringify(uploadResponse));\n\nconst form_data = msg.submission;\n\nconst userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\nglobal.set(`project_name_${userId}`, form_data.project_name);\n\n// 2) Credenciales ya generadas en el flujo (sin pedir a TalkG)\nconst bearerToken =\n    msg?.submission?.talkg_credentials?.bearer_token\n    || msg?.onInitSubmission?.talkg_credentials?.bearer_token;\n\nconst axetUserId = msg?.__axetFlowsSecurityContext?.axetUserId;\nconst assetId =\n    msg?.submission?.talkg_credentials?.assetId\n    || msg?.onInitSubmission?.talkg_credentials?.assetId;\n\nif (!bearerToken) {\n    node.error('❌ No hay bearer_token disponible en msg.(submission|onInitSubmission).talkg_credentials');\n    msg.payload = { success: false, error: 'bearer_token no disponible' };\n    return msg;\n}\nif (!axetUserId) {\n    node.error('❌ NO SE ENCONTRÓ AXET USER ID');\n    msg.payload = { success: false, error: 'Axet User ID no disponible' };\n    return msg;\n}\nif (!assetId) {\n    node.error('❌ NO SE ENCONTRÓ assetId');\n    msg.payload = { success: false, error: 'assetId no disponible' };\n    return msg;\n}\n\n// 3) Datos de contexto del proyecto/usuario\nconst oktaId = msg?.__axetFlowsSecurityContext?.oktaId;\nconst projectId = msg?.__axetFlowsSecurityContext?.axetProject?.id;\n\nif (!oktaId) {\n    node.error('❌ NO SE ENCONTRÓ oktaId en msg.__axetFlowsSecurityContext');\n    msg.payload = { success: false, error: 'oktaId no disponible' };\n    return msg;\n}\nif (!projectId) {\n    node.error('❌ NO SE ENCONTRÓ projectId en msg.__axetFlowsSecurityContext.axetProject.id');\n    msg.payload = { success: false, error: 'projectId no disponible' };\n    return msg;\n}\n\n// 4) Configuración Azure por USUARIO (global y única)\n//    - Claves: azure_openai_endpoint_<oktaId>, azure_openai_deployment_<oktaId>, azure_api_version_<oktaId>\n//    - Defaults si no existen: deployment = \"gpt-4.1\", api_version = \"2025-01-01-preview\"\n\nconst keyEndpoint = `azure_openai_endpoint_${oktaId}`;\nconst keyDeploy = `azure_openai_deployment_${oktaId}`;\nconst keyApiVersion = `azure_api_version_${oktaId}`;\n\n// Endpoint construido por projectId (sin trailing slash)\nlet azure_endpoint = global.get(keyEndpoint)\n    || `https://axet.nttdata.com/api/llm-enabler/v2/azure/openai/${projectId}`;\n\n// Deployment y API version con defaults si no existen aún\nlet azure_deployment = global.get(keyDeploy) || 'gpt-4.1';\nlet azure_api_version = global.get(keyApiVersion) || '2025-01-01-preview';\n\n// Guardar/cachedar en global para el usuario\nglobal.set(keyEndpoint, azure_endpoint);\nglobal.set(keyDeploy, azure_deployment);\nglobal.set(keyApiVersion, azure_api_version);\n\n// 5) Validar msg.submission básico\nif (!msg.submission) {\n    node.error('❌ msg.submission no existe');\n    return null;\n}\n\nconst mode = msg.submission.mode || 'manual';\nconst projectName = msg.submission.project_name || 'MiProyecto';\n\n// 7) Body para /generate\nconst generateBody = {\n    inventoryConfig: {\n        source_url: '',\n        token: '',\n        project_path: '',\n        include_cmdb: true,\n        include_documentation: true,\n        include_jobs: true,\n        use_ai_analysis: true\n    },\n    bearer_token: bearerToken,\n    azure_endpoint: azure_endpoint,\n    azure_deployment: azure_deployment,\n    azure_api_version: azure_api_version,\n    axet_user_id: axetUserId,\n    asset_id: assetId // opcional en body\n};\n\nconst jobId = form_data.job_id;\n\nlet analysisType = form_data.analysisType;\nlet analysisTitle = form_data.analysisTitle;\n\nnode.warn(`Consultando datos para JobId: ${jobId}`);\n\nconst jobUrl = `http://localhost:8000/api/v1/jobs/${jobId}/llm/${analysisType}`;\n\naxios.post(jobUrl, generateBody, {\n    headers: {\n        'Content-Type': 'application/json'\n    },\n    timeout: 240000\n})\n    .then(response => {\n        const data = response.data;\n\n        node.warn('✅ /generate OK');\n        node.warn(JSON.stringify(data, null, 2));\n\n        node.status({\n            fill: 'green',\n            shape: 'dot',\n            text: `Job ${data.job_id?.substring(0, 8)}...`\n        });\n\n        if (form_data.job_id) {\n            msg.submission.job_id = form_data.job_id;\n            msg.job_id = form_data.job_id;\n        }\n\n        msg.submission = {\n            job_id: form_data.job_id,\n            inventory: form_data.inventory,\n            response_analysis: data,\n            analysis_type: analysisTitle,\n            show_analysis: true,\n            download_url: form_data.download_url,\n            projectPath: form_data.projectPath\n        }\n\n        msg.payload.data = msg.submission;\n\n        node.send(msg);\n    })\n    .catch(error => {\n        node.status({ fill: 'red', shape: 'ring', text: 'Error' });\n        node.error('❌ ERROR EN /generate: ' + error.message);\n\n        if (error.response) {\n            node.error(`HTTP ${error.response.status}`);\n            node.error(JSON.stringify(error.response.data, null, 2));\n        }\n\n        msg.payload = {\n            success: false,\n            error: error.message,\n            detail: error.response?.data?.detail || null\n        };\n\n        node.send(msg);\n    });\n\nreturn null;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":640,"y":100,"wires":[["431f856b.459a24"]]},{"id":"80715f0f.df2258","type":"link out","z":"ef48fe5e.6a89","name":"","links":["37780500.e499a2"],"x":795,"y":340,"wires":[]},{"id":"37780500.e499a2","type":"link in","z":"ef48fe5e.6a89","name":"recarga pantalla","links":["80715f0f.df2258"],"x":1015,"y":180,"wires":[["431f856b.459a24"]]},{"id":"52b6b4ac.3695cc","type":"axetflows-app","z":"70ea28cb.36573","name":"Agente de aplicaciones","menu":[{"text":"Menu","icon":"fa fa-sitemap","data":{},"children":[{"id":"j1_8","text":"Admin. Area","icon":"fa fa-folder-open-o","data":{"form_permissions":["ROLE_ADMIN"]},"children":[{"id":"j1_7","text":"\uD83D\uDE80 instalación api","icon":"fa fa-desktop","data":{"form_id":"31d1a3b9.555b74","form_name":"\uD83D\uDE80 instalación api"},"children":[],"type":"form"},{"id":"j1_9","text":"User Okta Search Form","icon":"fa fa-desktop","data":{"form_id":"cb0bd8ec.58ebe8","form_permissions":["ROLE_ADMIN"]},"children":[],"type":"form"},{"id":"j1_10","text":"⚙️ configuración simplificada","icon":"fa fa-desktop","data":{"form_id":"form-config-simple","form_name":"⚙️ configuración simplificada"},"children":[],"type":"form"}],"type":"section"}],"type":"root"}],"welcomePage":"af85aade.cc55e8","sidebarMenuOrientation":"left","logoImage":"default","schemeColor":"19cec3df.6d82bc","customCSS":"/* === CONTENEDOR TARJETA: HEADER + FORM === */\n.analysis-header,\n.gitlab-form {\n  max-width: 1100px;       /* ancho fijo centrado */\n  margin-left: auto;\n  margin-right: auto;\n}\n\n/* Header superior de la tarjeta */\n.analysis-header {\n  margin-top: 40px;\n  margin-bottom: 0;         /* se pega al form */\n  padding: 24px 32px;\n  border-radius: 18px 18px 0 0;\n  background: radial-gradient(circle at 0 0, #273352 0, #141a29 50%, #0b1220 100%);\n  border: 1px solid #27324a;\n  border-bottom: none;      /* para que no se vea línea doble al unirse con el form */\n  box-shadow: 0 26px 60px rgba(15, 23, 42, 0.85);\n  color: #f9fafb;\n}\n\n/* Tarjeta del formulario (parte inferior) */\n.gitlab-form {\n  margin-top: 0;\n  margin-bottom: 48px;\n  padding: 24px 32px 32px;\n  border-radius: 0 0 18px 18px;\n  background: rgba(15, 23, 42, 0.97);\n  border: 1px solid #27324a;\n  box-shadow: 0 26px 60px rgba(15, 23, 42, 0.85);\n  color: #f9fafb;\n}\n\n/* === TIPOGRAFÍA DEL HEADER === */\n.analysis-title {\n  margin: 0 0 6px 0;\n  font-size: 18px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #e5e7eb;\n}\n\n.analysis-subtitle {\n  margin: 0;\n  font-size: 13px;\n  color: #9ca3af;\n}\n\n/* === CAMPOS DEL FORM === */\n.gitlab-form .form-title {\n  margin: 0 0 20px 0;\n  font-size: 20px;\n  font-weight: 600;\n}\n\n/* Etiquetas */\n.gitlab-form .control-label {\n  text-transform: uppercase;\n  font-size: 11px;\n  letter-spacing: 0.08em;\n  color: #d1d5db;\n  margin-bottom: 4px;\n}\n\n/* Inputs y selects */\n.gitlab-form .form-control,\n.gitlab-form select {\n  background-color: #111827;\n  border-radius: 10px;\n  border: 1px solid #374151;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);\n  color: #f9fafb;\n}\n\n.gitlab-form .form-control:focus,\n.gitlab-form select:focus {\n  border-color: #6366f1;\n  box-shadow: 0 0 0 1px #6366f1;\n}\n\n/* Textos de ayuda */\n.gitlab-form .hint {\n  font-size: 12px;\n  color: #9ca3af;\n}\n\n/* Panel “Opciones avanzadas” */\n.gitlab-form .advanced-panel .card,\n.gitlab-form .advanced-panel .panel {\n  background: rgba(15, 23, 42, 0.8);\n  border-radius: 14px;\n  border: 1px solid #374151;\n}\n\n.gitlab-form .advanced-panel .card-header,\n.gitlab-form .advanced-panel .panel-heading {\n  background: transparent;\n  border-bottom: none;\n  color: #93c5fd;\n  font-weight: 600;\n  padding: 8px 16px;\n}\n\n.gitlab-form .advanced-panel .card-body,\n.gitlab-form .advanced-panel .panel-body {\n  padding: 16px;\n}\n\n/* Botón principal (clase md-button.gitlab-primary en el nodo) */\n.md-button.gitlab-primary,\n.gitlab-form .btn-primary {\n  border-radius: 9999px;\n  background-image: linear-gradient(90deg, #6366f1, #8b5cf6);\n  color: #ffffff !important;\n  text-transform: none;\n  font-weight: 600;\n}\n","customCSSErrors":0,"authConfig":"Okta","sessionExpireTimeInMinutes":"","basicInternalDb":"","oktaDb":"b03ba2b3.584618","authLdapDb":"","authLdapUrl":"","authLdapDomainConfig":null,"authLdapDomains":[],"authLdapAdvancedDomains":[],"authCasDb":"","authCasUrl":"","authOpenIdDb":"","authOpenIdWellKnownUrl":"","authOpenIdTokenAuthMethod":"","authOpenIdEndSessionUrl":"","authOpenIdScopes":[],"authOpenIdAuthUrlParams":{},"authAzureAdDb":"","authAzureAdAuthorityUrl":"","authAzureAdLogoutUrl":"","authAzureAdScopes":[],"roles":[],"x":180,"y":80,"wires":[]},{"id":"ca1ccbd0.b67048","type":"subflow:29fbdd7d.36c0.4199.940c.3d96e519b52c","z":"70ea28cb.36573","name":"","env":[],"x":400,"y":280,"wires":[["5d6e8d8c.2c0e9c"]]},{"id":"5d6e8d8c.2c0e9c","type":"function","z":"70ea28cb.36573","name":"1. Generate","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"2. Generate - USAR TOKEN EXISTENTE + axet-asset-id header\"\n// ═══════════════════════════════════════════════════════════════\n\nconst uploadResponse = msg.payload;\nconst axios = global.get('axios') || require('axios');\n\nnode.warn('\uD83D\uDCE5 Upload response: ' + JSON.stringify(uploadResponse));\n\nconst formData = msg.submission;\n\nif (!formData) {\n    node.error('❌ No hay datos en msg.submission');\n    node.status({ fill: 'red', shape: 'ring', text: 'Sin datos' });\n    return null;\n}\n\nconst userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\nglobal.set(`project_name_${userId}`, formData.project_name);\n\n// 2) Credenciales ya generadas en el flujo (sin pedir a TalkG)\nconst bearerToken =\n    msg?.submission?.talkg_credentials?.bearer_token\n    || msg?.onInitSubmission?.talkg_credentials?.bearer_token;\n\nconst axetUserId = msg?.__axetFlowsSecurityContext?.axetUserId;\nconst assetId =\n    msg?.submission?.talkg_credentials?.assetId\n    || msg?.onInitSubmission?.talkg_credentials?.assetId;\n\nif (!bearerToken) {\n    node.error('❌ No hay bearer_token disponible en msg.(submission|onInitSubmission).talkg_credentials');\n    msg.payload = { success: false, error: 'bearer_token no disponible' };\n    return msg;\n}\nif (!axetUserId) {\n    node.error('❌ NO SE ENCONTRÓ AXET USER ID');\n    msg.payload = { success: false, error: 'Axet User ID no disponible' };\n    return msg;\n}\nif (!assetId) {\n    node.error('❌ NO SE ENCONTRÓ assetId');\n    msg.payload = { success: false, error: 'assetId no disponible' };\n    return msg;\n}\n\n// 3) Datos de contexto del proyecto/usuario\nconst oktaId = msg?.__axetFlowsSecurityContext?.oktaId;\nconst projectId = msg?.__axetFlowsSecurityContext?.axetProject?.id;\n\nif (!oktaId) {\n    node.error('❌ NO SE ENCONTRÓ oktaId en msg.__axetFlowsSecurityContext');\n    msg.payload = { success: false, error: 'oktaId no disponible' };\n    return msg;\n}\nif (!projectId) {\n    node.error('❌ NO SE ENCONTRÓ projectId en msg.__axetFlowsSecurityContext.axetProject.id');\n    msg.payload = { success: false, error: 'projectId no disponible' };\n    return msg;\n}\n\n// 4) Configuración Azure por USUARIO (global y única)\n//    - Claves: azure_openai_endpoint_<oktaId>, azure_openai_deployment_<oktaId>, azure_api_version_<oktaId>\n//    - Defaults si no existen: deployment = \"gpt-4.1\", api_version = \"2025-01-01-preview\"\n\nconst keyEndpoint = `azure_openai_endpoint_${oktaId}`;\nconst keyDeploy = `azure_openai_deployment_${oktaId}`;\nconst keyApiVersion = `azure_api_version_${oktaId}`;\n\n// Endpoint construido por projectId (sin trailing slash)\nlet azure_endpoint = global.get(keyEndpoint)\n    || `https://axet.nttdata.com/api/llm-enabler/v2/azure/openai/${projectId}`;\n\n// Deployment y API version con defaults si no existen aún\nlet azure_deployment = global.get(keyDeploy) || 'gpt-4.1';\nlet azure_api_version = global.get(keyApiVersion) || '2025-01-01-preview';\n\n// Guardar/cachedar en global para el usuario\nglobal.set(keyEndpoint, azure_endpoint);\nglobal.set(keyDeploy, azure_deployment);\nglobal.set(keyApiVersion, azure_api_version);\n\n// 5) Validar msg.submission básico\nif (!msg.submission) {\n    node.error('❌ msg.submission no existe');\n    return null;\n}\n\nconst mode = msg.submission.mode || 'manual';\nconst projectName = msg.submission.project_name || 'MiProyecto';\n\n// 6) Logs útiles (sin exponer el token completo)\nnode.warn('═══════════════════════════════════════');\nnode.warn('\uD83D\uDD0D DATOS PARA /generate');\nnode.warn('═══════════════════════════════════════');\nnode.warn(`⚙️  mode: ${mode}`);\nnode.warn(`\uD83D\uDCC1 project_name: ${projectName}`);\nnode.warn('');\nnode.warn('\uD83D\uDD10 AUTENTICACIÓN:');\nnode.warn(`   Bearer Token: ${String(bearerToken).substring(0, 30)}...`);\nnode.warn(`   Axet User ID: ${axetUserId}`);\nnode.warn(`   Asset ID    : ${assetId}`);\nnode.warn('');\nnode.warn('☁️  AZURE CONFIG (por usuario):');\nnode.warn(`   Endpoint   : ${azure_endpoint}`);\nnode.warn(`   Deployment : ${azure_deployment}`);\nnode.warn(`   API Version: ${azure_api_version}`);\nnode.warn('═══════════════════════════════════════');\n\n// 7) Body para /generate\nconst generateBody = {\n    inventoryConfig: {\n        source_url: formData.repository_url,\n        token: formData.token,\n        project_path: formData.project_path,\n        include_cmdb: formData.include_cmdb,\n        include_documentation: formData.include_documentation,\n        include_jobs: formData.include_jobs,\n        use_ai_analysis: formData.use_ai_analysis      \n    },\n    bearer_token: bearerToken,\n    azure_endpoint: azure_endpoint,\n    azure_deployment: azure_deployment,\n    azure_api_version: azure_api_version,\n    axet_user_id: axetUserId,\n    asset_id: assetId // opcional en body\n};\n\n// 8) Llamada a /api/v1/generate (propagando header axet-asset-id)\nnode.status({\n    fill: 'blue',\n    shape: 'ring',\n    text: `Generando (${azure_deployment})...`\n});\n\naxios.post('http://localhost:8000/api/v1/analyze', generateBody, {\n    headers: {\n        'Content-Type': 'application/json',\n        'axet-asset-id': assetId,   // ← header correcto para el enabler\n    },\n    timeout: 240000\n})\n    .then(response => {\n        const data = response.data;\n\n        node.warn('✅ /generate OK');\n        node.warn(JSON.stringify(data, null, 2));\n\n        node.status({\n            fill: 'green',\n            shape: 'dot',\n            text: `Job ${data.job_id?.substring(0, 8)}...`\n        });\n\n        if (data.job_id) {\n            msg.submission.job_id = data.job_id;\n            msg.job_id = data.job_id;\n        }\n\n        msg.payload = data;\n        node.send(msg);\n    })\n    .catch(error => {\n        node.status({ fill: 'red', shape: 'ring', text: 'Error' });\n        node.error('❌ ERROR EN /generate: ' + error.message);\n\n        if (error.response) {\n            node.error(`HTTP ${error.response.status}`);\n            node.error(JSON.stringify(error.response.data, null, 2));\n        }\n\n        msg.payload = {\n            success: false,\n            error: error.message,\n            detail: error.response?.data?.detail || null\n        };\n\n        node.send(msg);\n    });\n\nreturn null;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":590,"y":280,"wires":[["11d8190e.4251d7","1fe690dc.646517"]]},{"id":"11d8190e.4251d7","type":"debug","z":"70ea28cb.36573","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":810,"y":200,"wires":[]},{"id":"b9526dec.106bf","type":"function","z":"70ea28cb.36573","name":"Load","func":"const userId = \"prueba\"\n\n// Mapear SOLO los 3 campos necesarios\nconst formData = {\n    repository_url : \"\",\n    token : \"\",\n    project_path : \"\",\n    auto_discover_groups : \"Si\",\n    include_cmdb : \"Si\",\n    include_documentation : \"Si\",\n    include_jobs : \"Si\",\n    use_ai_analysis : \"Si\",\n};\n\n// ✅ Asignar los datos al payload para que el formulario los tome\nmsg.payload = msg.payload || {};\nmsg.payload.data = formData;\n\n// También en msg.submission por si axetflows lo necesita\nmsg.submission = formData;\n\nnode.warn(`✅ Formulario precargado con datos del usuario ${userId}`);\nnode.warn(`   Modelo: ${formData.aiModel}`);\nnode.warn(`   API Version: ${formData.apiVersion}`);\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":390,"y":340,"wires":[["6eeec58d.5adb3c"]]},{"id":"6eeec58d.5adb3c","type":"axetflows-view-action","z":"70ea28cb.36573","name":"","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":550,"y":340,"wires":[]},{"id":"1cca4997.d04a1e","type":"use-case","z":"70ea28cb.36573","name":"","userid":"00u9pqw2ffoePJQOV417","projectid":"11f8c3f4-6001-4c25-912c-dde0aa6ebff1","useCaseCategory":"CA","usecaseid":"UC-0518-FLOW-001","isAI":"","x":400,"y":220,"wires":[]},{"id":"1fe690dc.646517","type":"function","z":"70ea28cb.36573","name":"3. Guardar job_id e iniciar polling","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"3. Guardar job_id e iniciar polling - CORREGIDO\"\n// ═══════════════════════════════════════════════════════════════\n\nconst generateResponse = msg.payload;\n\nnode.warn('\uD83D\uDCE5 Generate response: ' + JSON.stringify(generateResponse));\n\n// ═══════════════════════════════════════════════════════════════\n// ✅ VALIDAR RESPUESTA DE /generate\n// ═══════════════════════════════════════════════════════════════\nif (!generateResponse || !generateResponse.job_id) {\n    node.error('❌ No se recibió job_id en la respuesta de /generate');\n    node.error('   Response: ' + JSON.stringify(generateResponse));\n    node.status({ fill: 'red', shape: 'ring', text: 'Sin job_id' });\n    return null;\n}\n\nconst jobId = generateResponse.job_id;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ CAMBIO: GUARDAR EN msg.submission EN LUGAR DE flow.set()\n// ═══════════════════════════════════════════════════════════════\nif (!msg.submission) {\n    msg.submission = {};\n}\n\n// ⭐ GUARDAR job_id EN msg.submission (ÚNICO POR USUARIO)\nmsg.submission.job_id = jobId;\n\n// También guardarlo directamente en msg para el siguiente nodo HTTP request\nmsg.job_id = jobId;\n\nnode.status({ \n    fill: 'yellow', \n    shape: 'ring', \n    text: `Job ${jobId.substring(0, 8)}... iniciado` \n});\n\nnode.warn(`✅ job_id guardado en msg.submission: ${jobId}`);\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDD04 PREPARAR PARA POLLING (HTTP REQUEST)\n// ═══════════════════════════════════════════════════════════════\nmsg.payload = {\n    job_id: jobId\n};\n\nmsg.url = `http://localhost:8000/api/v1/jobs/${jobId}`;\nmsg.method = 'GET';\nmsg.headers = {};\n\nnode.warn(`\uD83D\uDD04 Iniciando polling para job_id: ${jobId}`);\nnode.warn(`   URL: ${msg.url}`);\n\n// ⭐ RETORNAR msg (este nodo SÍ debe devolver msg sincronamente)\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":940,"y":320,"wires":[["f3d27bc6.73107"]]},{"id":"f079219.478df6","type":"debug","z":"70ea28cb.36573","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":1630,"y":280,"wires":[]},{"id":"f3d27bc6.73107","type":"delay","z":"70ea28cb.36573","name":"Espera 2s","pauseType":"delay","timeout":"2","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"x":1320,"y":320,"wires":[["5c7c8141.f5b11"]]},{"id":"5c7c8141.f5b11","type":"function","z":"70ea28cb.36573","name":"4. JobId","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"3. Guardar job_id, iniciar polling Y DETECTAR ERRORES\"\n// ═══════════════════════════════════════════════════════════════\n\nconst axios = global.get('axios') || require('axios');\nlet generateResponse = msg.payload;\n\nnode.warn('\uD83D\uDCE5 Generate response: ' + JSON.stringify(generateResponse));\nnode.warn('cargando job_id' + msg.submission.job_id)\nif (msg.submission.job_id){\n    generateResponse = msg.submission;\n}\n// ═══════════════════════════════════════════════════════════════\n// ✅ VALIDAR RESPUESTA DE /generate\n// ═══════════════════════════════════════════════════════════════\nif (!generateResponse || !generateResponse.job_id || !msg.submission.job_id) {\n    node.error('❌ No se recibió job_id en la respuesta de /generate');\n    node.error('   Response: ' + JSON.stringify(generateResponse));\n    node.status({ fill: 'red', shape: 'ring', text: 'Sin job_id' });\n\n    msg.payload = {\n        success: false,\n        error: 'No se recibió job_id del servidor'\n    };\n\n    msg._viewAction = {\n        action: 'update',\n        message: '❌ Error: No se pudo iniciar la generación de código',\n        messageType: 'danger'\n    };\n\n    return msg;\n}\n\nconst jobId = generateResponse.job_id || msg.submission.job_id;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ GUARDAR EN msg.submission\n// ═══════════════════════════════════════════════════════════════\nif (!msg.submission) {\n    msg.submission = {};\n}\n\nmsg.submission.job_id = jobId;\nmsg.job_id = jobId;\n\nnode.status({\n    fill: 'yellow',\n    shape: 'ring',\n    text: `Job ${jobId.substring(0, 8)}... iniciado`\n});\n\nnode.warn(`✅ job_id guardado en msg.submission: ${jobId}`);\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDD04 INICIAR PRIMER POLLING\n// ═══════════════════════════════════════════════════════════════\nconst jobUrl = `http://localhost:8000/api/v1/jobs/${jobId}`;\nnode.warn(`\uD83D\uDCE1 Iniciando polling: GET ${jobUrl}`);\n\naxios.get(jobUrl, {\n    timeout: 60000\n})\n    .then(response => {\n        const data = response.data;\n\n        node.warn('✅ /jobs response: ' + JSON.stringify(data));\n\n        // ═══════════════════════════════════════════════════════════\n        // ⭐ DETECTAR SI EL JOB FALLÓ\n        // ═══════════════════════════════════════════════════════════\n        if (data.status === 'failed') {\n            node.error('═══════════════════════════════════════');\n            node.error('❌ JOB FALLÓ');\n            node.error('═══════════════════════════════════════');\n            node.error(`Job ID: ${jobId}`);\n            node.error(`Mensaje: ${data.message || 'Sin mensaje'}`);\n            node.error(`Error: ${data.error || 'Sin detalles'}`);\n            node.error('═══════════════════════════════════════');\n\n            node.status({\n                fill: 'red',\n                shape: 'ring',\n                text: 'Job falló'\n            });\n\n            // ⭐ PREPARAR MENSAJE DE ERROR\n            const errorMessage = data.message || data.error || 'Error desconocido';\n            let userFriendlyError = errorMessage;\n\n            // ⭐ ERRORES ESPECÍFICOS DE BEARER TOKEN\n            if (errorMessage.includes('401') ||\n                errorMessage.includes('Unauthorized') ||\n                errorMessage.includes('Authentication failed')) {\n                userFriendlyError = '\uD83D\uDD10 Token de autenticación inválido o expirado. Por favor, cierre sesión y vuelva a iniciar sesión.';\n\n            } else if (errorMessage.includes('403') ||\n                errorMessage.includes('Forbidden')) {\n                userFriendlyError = '\uD83D\uDEAB No tiene permisos para usar Azure OpenAI con su cuenta actual.';\n\n            } else if (errorMessage.includes('Bearer token') ||\n                errorMessage.includes('bearer_token')) {\n                userFriendlyError = '\uD83D\uDD11 Error con el token de autenticación. Intente cerrar sesión y volver a entrar.';\n\n            } else if (errorMessage.includes('Azure OpenAI')) {\n                userFriendlyError = '☁️ Error de Azure OpenAI: ' + errorMessage.substring(0, 200);\n\n            } else if (errorMessage.includes('AZURE_OPENAI_ENDPOINT') ||\n                errorMessage.includes('AZURE_OPENAI_DEPLOYMENT')) {\n                userFriendlyError = '⚙️ Configuración de Azure incompleta en el servidor. Contacte al administrador.';\n            }\n\n            // ⭐ ENVIAR ERROR AL FRONTEND\n            msg.payload = {\n                success: false,\n                status: 'failed',\n                job_id: jobId,\n                error: errorMessage,\n                error_summary: userFriendlyError\n            };\n\n            msg._viewAction = {\n                action: 'update',\n                message: userFriendlyError,\n                messageType: 'danger'\n            };\n\n            node.send(msg);\n            return;\n        }\n\n        // ═══════════════════════════════════════════════════════════\n        // ✅ JOB EN PROGRESO O COMPLETADO\n        // ═══════════════════════════════════════════════════════════\n\n        node.status({\n            fill: data.status === 'completed' ? 'green' : 'yellow',\n            shape: 'dot',\n            text: `Status: ${data.status || 'unknown'}`\n        });\n\n        if (!msg.submission) msg.submission = {};\n        msg.submission.job_id = jobId;\n        msg.job_id = jobId;\n\n        msg.payload = data;\n\n        if (data.status === 'processing' || data.status === 'pending') {\n            msg._viewAction = {\n                action: 'update',\n                message: `⏳ ${data.message || 'Procesando...'}`,\n                messageType: 'info'\n            };\n            msg.submission.current_task = `⏳ ${data.message || 'Procesando...'}`\n        } else if (data.status === 'completed') {\n            msg._viewAction = {\n                action: 'update',\n                message: '✅ Análisis generado exitosamente',\n                messageType: 'success'\n            };\n        }\n\n        node.send(msg);\n    })\n    .catch(error => {\n        node.status({ fill: 'red', shape: 'ring', text: 'Error en /jobs' });\n\n        node.error('═══════════════════════════════════════');\n        node.error('❌ ERROR AL CONSULTAR JOB');\n        node.error('═══════════════════════════════════════');\n        node.error('Error: ' + error.message);\n\n        if (error.response) {\n            node.error('HTTP Status: ' + error.response.status);\n            node.error('Response Data: ' + JSON.stringify(error.response.data));\n        }\n\n        if (error.code === 'ECONNREFUSED') {\n            node.error('⚠️ No se puede conectar al servidor API');\n        }\n\n        if (error.code === 'ETIMEDOUT') {\n            node.error('⚠️ Timeout: El servidor tardó más de 60s en responder');\n        }\n\n        node.error('═══════════════════════════════════════');\n\n        msg.payload = {\n            success: false,\n            error: error.message,\n            error_detail: error.response?.data || null\n        };\n\n        msg._viewAction = {\n            action: 'update',\n            message: `❌ Error al consultar estado: ${error.message}`,\n            messageType: 'danger'\n        };\n\n        node.send(msg);\n    });\n\nreturn null;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":1480,"y":320,"wires":[["f079219.478df6","edd92938.9682c"]]},{"id":"287a4b10.815244","type":"delay","z":"70ea28cb.36573","name":"","pauseType":"delay","timeout":"3","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"x":1460,"y":220,"wires":[["5c7c8141.f5b11"]]},{"id":"545c1841.6173f","type":"link in","z":"70ea28cb.36573","name":"feedin","links":["b10da737.f7a67"],"x":1195,"y":380,"wires":[["f3d27bc6.73107"]]},{"id":"5cfa3242.5bc3dc","type":"axetflows-form","z":"70ea28cb.36573","name":"Vista de Progreso AUTO-REFRESH","onDocumentReadyButtonAction":"","formStructure":{"components":[{"type":"htmlelement","tag":"div","content":"{{data.progress_html}}","input":false,"key":"progress_display","refreshOnChange":true,"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","tableView":false,"modalEdit":false,"label":"HTML","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"attrs":[],"id":"ei9yy7c"},{"type":"htmlelement","tag":"div","content":"<p style='text-align: center; color: #999; font-size: 0.9em; margin-top: 20px;'>⏳ Actualizando cada 2 segundos...</p>","input":false,"key":"","placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","tableView":false,"modalEdit":false,"label":"HTML","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"attrs":[],"id":"ez0i2fg"},{"type":"hidden","key":"job_id","input":true,"persistent":true,"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","tableView":false,"modalEdit":false,"label":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"inputType":"hidden","id":"emsnjb"},{"type":"hidden","key":"polling_active","defaultValue":true,"input":true,"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"protected":false,"unique":false,"persistent":true,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","tableView":false,"modalEdit":false,"label":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"inputType":"hidden","id":"egn95ep"}]},"buttons":[],"outputs":1,"x":1560,"y":20,"wires":[["2d610e4c.60df0a"]]},{"id":"2d610e4c.60df0a","type":"function","z":"70ea28cb.36573","name":"","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Continue Polling\" - SIN LOOPS INFINITOS\n// ═══════════════════════════════════════════════════════════════\n\n// ⭐ SOLO procesar si viene del formulario de progreso\nif (!msg.submission || !msg.submission.job_id) {\n    node.warn('⏭️ Mensaje no viene del formulario de progreso, ignorando');\n    return null;\n}\n\nconst jobId = msg.submission.job_id;\n\nnode.warn(`\uD83D\uDD04 Programando siguiente polling para job ${jobId.substring(0, 8)} en 5 segundos...`);\n\n// ⭐ Marcar que este mensaje ya fue procesado\nif (msg._pollingScheduled) {\n    node.warn('⚠️ Polling ya programado para este mensaje, evitando duplicado');\n    return null;\n}\n\nmsg._pollingScheduled = true;\n\n// ⭐ Simplemente enviar el mensaje al delay, que luego irá a \"4. JobId\"\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":1500,"y":120,"wires":[["287a4b10.815244"]]},{"id":"edd92938.9682c","type":"subflow:01309592.14e4.4d5a.834c.655f33ccdfdb","z":"70ea28cb.36573","name":"","env":[],"x":1660,"y":380,"wires":[]},{"id":"af85aade.cc55e8","type":"axetflows-form","z":"70ea28cb.36573","name":"Initial Form","onDocumentReadyButtonAction":"","formStructure":{"components":[{"label":"HTML","tag":"style","className":"","attrs":[{"attr":"","value":""}],"content":"/* ─────────────────────────────────────────────────────────────────────────────\r\n\t PALETA Y RESET\r\n───────────────────────────────────────────────────────────────────────────── */\r\n*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\r\n:root{\r\n\t--bg: #0b1220;\r\n\t--bg-alt: #131d30;\r\n\t--panel: #1e2a3d;\r\n\t--panel-soft: #25364b;\r\n\t--border: #2f455e;\r\n\t--border-soft:#1d2a3b;\r\n\t--accent: #6366f1;\r\n\t--accent-hover:#5255e9;\r\n\t--accent-gradient: linear-gradient(135deg,#6366f1 0%,#818cf8 55%,#a5b4fc 100%);\r\n\t--danger:#dc2626;\r\n\t--success:#16a34a;\r\n\t--warning:#f59e0b;\r\n\t--text:#f1f5f9;\r\n\t--text-dim:#94a3b8;\r\n\t--radius:14px;\r\n\t--shadow:0 4px 18px -4px rgba(0,0,0,.4),0 2px 6px -2px rgba(0,0,0,.35);\r\n\t--trans:0.18s cubic-bezier(.4,.2,.2,1);\r\n}\r\nbody{background:radial-gradient(circle at 25% 15%,#142235,#0b1220 55%) fixed;color:var(--text);line-height:1.5;min-height:100vh;}\r\nheader,footer{padding:1.15rem 1.75rem;background:rgba(30,42,61,.85);backdrop-filter:blur(6px);border-bottom:1px solid var(--border-soft)}\r\nheader h1{margin:0;font-size:1.35rem;font-weight:600;letter-spacing:.5px;background:var(--accent-gradient);-webkit-background-clip:text;background-clip:text;color:transparent}\r\nmain{max-width:1220px;margin:1.25rem auto;padding:0 1.25rem;display:grid;gap:1.25rem}\r\n\r\n/* ─────────────────────────────────────────────────────────────────────────────\r\n\t COMPONENTES\r\n───────────────────────────────────────────────────────────────────────────── */\r\n.card{background:linear-gradient(145deg,#1d2838,#233146 60%,#1b2738);padding:1.1rem 1.3rem;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow);position:relative;overflow:hidden}\r\n.card:before{content:\"\";position:absolute;inset:0;background:radial-gradient(circle at 85% 15%,rgba(255,255,255,.06),transparent 55%);opacity:.7;pointer-events:none}\r\n.card h2{margin:0 0 .65rem;font-size:1.05rem;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--text-dim)}\r\n\r\nform{display:grid;gap:.9rem}\r\nlabel{display:grid;gap:.4rem;font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim)}\r\ninput,select{width:100%;padding:.7rem .8rem;border:1px solid var(--border);border-radius:10px;background:#0f1929;color:var(--text);font-size:.85rem;transition:var(--trans);}\r\ninput:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(99,102,241,.25)}\r\ndetails{border:1px solid var(--border);border-radius:10px;padding:.5rem .75rem;background:#192536}\r\ndetails[open]{background:#1d2d42}\r\ndetails summary{cursor:pointer;font-size:.75rem;font-weight:600;color:var(--accent);}\r\n\r\nbutton{cursor:pointer;font-weight:600;padding:.7rem 1rem;border-radius:10px;border:1px solid var(--border);background:var(--panel-soft);color:var(--text);font-size:.75rem;letter-spacing:.05em;transition:var(--trans);position:relative;overflow:hidden}\r\nbutton:hover{background:#314766}\r\nbutton#startBtn{background:var(--accent-gradient);border:none;color:#fff;box-shadow:0 4px 14px -4px rgba(99,102,241,.55)}\r\nbutton#startBtn:hover{filter:brightness(1.05)}\r\nbutton:disabled{opacity:.55;cursor:not-allowed}\r\n\r\n.status{margin-top:.4rem;font-size:.7rem;min-height:1.1rem;font-weight:500;letter-spacing:.04em;color:var(--text-dim)}\r\n.status.error{color:var(--danger)}\r\n.status.info{color:var(--accent)}\r\n.status.success{color:var(--success)}\r\n\r\n.hidden{display:none}\r\n\r\n/* ─────────────────────────────────────────────────────────────────────────────\r\n\t ACCORDION STYLES\r\n───────────────────────────────────────────────────────────────────────────── */\r\n#insights-accordion, #recommendations-accordion {\r\n\tcursor: pointer;\r\n\tdisplay: flex;\r\n\tjustify-content: space-between;\r\n\talign-items: center;\r\n\tuser-select: none;\r\n\ttransition: var(--trans);\r\n}\r\n\r\n#insights-accordion:hover, #recommendations-accordion:hover {\r\n\tbackground: rgba(99, 102, 241, 0.1);\r\n\tborder-color: var(--accent);\r\n}\r\n\r\n#insights-toggle, #recommendations-toggle {\r\n\tfont-size: 1.1rem;\r\n\ttransition: transform 0.3s cubic-bezier(0.4, 0.2, 0.2, 1);\r\n\tdisplay: inline-block;\r\n}\r\n\r\n#insights-section, #recommendations-section {\r\n\ttransition: all 0.3s cubic-bezier(0.4, 0.2, 0.2, 1);\r\n\tmax-height: 2000px;\r\n\toverflow: hidden;\r\n\topacity: 1;\r\n}\r\n\r\n#insights-section.hidden, #recommendations-section.hidden {\r\n\tmax-height: 0;\r\n\topacity: 0;\r\n\tpadding: 0 !important;\r\n\tmargin: 0 !important;\r\n\tborder: none !important;\r\n}\r\n\r\ntable{width:100%;border-collapse:separate;border-spacing:0;font-size:.75rem;overflow:hidden;border:1px solid var(--border);border-radius:12px;background:var(--panel-soft)}\r\nthead th{padding:.6rem .7rem;text-align:left;background:#2a3c52;color:var(--text-dim);font-weight:700;font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;border-bottom:1px solid var(--border)}\r\ntbody td{padding:.55rem .7rem;border-bottom:1px solid #28394e}\r\ntbody tr:last-child td{border-bottom:none}\r\ntbody tr{transition:var(--trans)}\r\ntbody tr:hover{background:#2b4159}\r\ntbody tr:active{filter:brightness(1.08)}\r\n\r\n#projects-table button{background:#2a3d54;border:1px solid #355170;font-size:.6rem;padding:.45rem .7rem;border-radius:8px;letter-spacing:.04em}\r\n#projects-table button:hover{background:#365372}\r\n\r\n.badge{display:inline-flex;align-items:center;gap:.25rem;padding:.28rem .6rem;border-radius:40px;font-size:.58rem;font-weight:600;letter-spacing:.04em;background:#33465c;color:#fff;box-shadow:0 2px 4px -1px #0006}\r\n.badge.inactiva{background:var(--danger)}\r\n.badge.activa{background:var(--success)}\r\n.badge.latente{background:var(--warning);color:#1e1e1e}\r\n\r\n.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-top:.9rem}\r\n.metric{padding:.65rem .75rem;background:#102035;border:1px solid var(--border);border-radius:12px;text-align:center;position:relative;isolation:isolate;overflow:hidden}\r\n.metric:before{content:\"\";position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.05),transparent 60%);opacity:.8;pointer-events:none}\r\n.metric h3{margin:.25rem 0;font-size:.62rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim)}\r\n.metric p{margin:0;font-size:1.15rem;font-weight:700;color:#fff;text-shadow:0 1px 2px #000}\r\n\r\n#branches-detail.hidden{display:none}\r\n\r\n#dashboard-actions button{flex:1 1 auto;min-width:130px}\r\n#dashboard-actions{background:linear-gradient(120deg,#1d2838,#243448);border:1px solid var(--border);}\r\nfooter{text-align:center;font-size:.65rem;color:var(--text-dim);margin:2.5rem 0 1rem}\r\n\r\n/* Scrollbar sutil */\r\n::-webkit-scrollbar{width:10px;height:10px}\r\n::-webkit-scrollbar-track{background:#0b1220}\r\n::-webkit-scrollbar-thumb{background:#1f2f44;border-radius:6px;border:2px solid #0b1220}\r\n::-webkit-scrollbar-thumb:hover{background:#29425e}\r\n\r\n/* Pequeña animación de aparición */\r\n.card, .metric, table, button{animation:fadeIn .5s ease}\r\n@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}\r\n\r\n/* Responsive ajustes */\r\n@media (max-width:740px){\r\n\tmain{gap:1rem}\r\n\theader h1{font-size:1.15rem}\r\n\t.summary-grid{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}\r\n\t#dashboard-actions button{min-width:100px;padding:.55rem .6rem;font-size:.63rem}\r\n\tbutton{font-size:.7rem}\r\n}","refreshOnChange":false,"customClass":"","hidden":false,"tableView":false,"modalEdit":false,"key":"html1","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"htmlelement","input":false,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"ey2ykiq"},{"label":"HTML","tag":"p","className":"","attrs":[{"attr":"","value":""}],"content":"<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <title>Application Inventory Agent</title>\r\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\r\n  <link rel=\"stylesheet\" href=\"style.css\" />\r\n</head>\r\n<body>\r\n  <header>\r\n    <h1>� Application Inventory Agent</h1>\r\n  </header>\r\n\r\n  <main id=\"app\">\r\n    <section id=\"form-section\" class=\"card\">\r\n      <h2>\uD83D\uDD0D Analizar Inventario de Aplicaciones</h2>\r\n      <form id=\"analyze-form\">\r\n        <label>URL de Fuente\r\n          <input type=\"text\" name=\"source_url\" id=\"source_url\" placeholder=\"https://gitlab.com/grupo o https://github.com/org o https://dev.azure.com/org\" required />\r\n          <small id=\"source-type-hint\" style=\"display:none;color:#94a3b8;font-size:0.75rem;margin-top:0.25rem;\"></small>\r\n        </label>\r\n        \r\n        <label>Token de Autenticación\r\n          <input type=\"password\" name=\"token\" id=\"token\" placeholder=\"TOKEN\" required />\r\n        </label>\r\n        \r\n        <details>\r\n          <summary>Opciones avanzadas</summary>\r\n          \r\n          <label>Ruta del Proyecto (opcional)\r\n            <input type=\"text\" name=\"project_path\" id=\"project_path\" placeholder=\"grupo/proyecto\" />\r\n          </label>\r\n          \r\n          <label>Auto-descubrir Grupos\r\n            <select name=\"auto_discover_groups\" id=\"auto_discover_groups\">\r\n              <option value=\"true\" selected>Sí</option>\r\n              <option value=\"false\">No</option>\r\n            </select>\r\n          </label>\r\n          \r\n          <label>Incluir CMDB\r\n            <select name=\"include_cmdb\" id=\"include_cmdb\">\r\n              <option value=\"true\" selected>Sí</option>\r\n              <option value=\"false\">No</option>\r\n            </select>\r\n          </label>\r\n          \r\n          <label>Incluir Documentación\r\n            <select name=\"include_documentation\" id=\"include_documentation\">\r\n              <option value=\"true\" selected>Sí</option>\r\n              <option value=\"false\">No</option>\r\n            </select>\r\n          </label>\r\n          \r\n          <label>Incluir Jobs (Control-M, Airflow)\r\n            <select name=\"include_jobs\" id=\"include_jobs\">\r\n              <option value=\"true\" selected>Sí</option>\r\n              <option value=\"false\">No</option>\r\n            </select>\r\n          </label>\r\n          \r\n          <label>Análisis con IA\r\n            <select name=\"use_ai_analysis\" id=\"use_ai_analysis\">\r\n              <option value=\"true\" selected>Sí</option>\r\n              <option value=\"false\">No</option>\r\n            </select>\r\n          </label>\r\n        </details>\r\n        \r\n        <button type=\"submit\" id=\"startBtn\">Iniciar Análisis</button>\r\n      </form>\r\n      <div id=\"status\" class=\"status\"></div>\r\n    </section>\r\n  </main>\r\n  <script src=\"example.js\"></script>\r\n</body>\r\n</html>","refreshOnChange":true,"customClass":"","hidden":false,"tableView":false,"modalEdit":false,"key":"html","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"htmlelement","input":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"eayq7ym"},{"content":"$(document).ready(async function () {\r\n    $('.formio-component-button').hide();\r\n    $('.alerts-status-bar').hide();\r\n    const repositoryUrlControl = document.getElementById('source_url');\r\n    const tokenControl = document.getElementById('token');\r\n    const projectPathControl = document.getElementById('project_path');\r\n    const autoDiscoverGroupsControl = document.getElementById('auto_discover_groups');\r\n    const includeCmdbControl = document.getElementById('include_cmdb');\r\n    const includeDocumentationControl = document.getElementById('include_documentation');\r\n    const includeJobsControl = document.getElementById('include_jobs');\r\n    const useAIAnalysisControl = document.getElementById('use_ai_analysis');\r\n    \r\n    function loadFormData(){\r\n      repositoryUrlControl.value = data.repository_url;\r\n      tokenControl.value = data.token;\r\n    }\r\n    \r\n    function metric(label, value){\r\n      return `<div class=\"metric\"><h3>${escapeHtml(label)}</h3><p>${value ?? 0}</p></div>`;\r\n    }\r\n    \r\n    function escapeHtml(s){\r\n      return (s==null?'':String(s)).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[c]));\r\n    }\r\n    \r\n    function processUserMessage() {\r\n        console.log('processUserMessage ejecutado');\r\n\r\n        // Check if we're in production environment\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[submit]\"]');\r\n\r\n        if (submitButton) {\r\n            // Production environment - use existing flow\r\n            if (typeof data !== 'undefined') {\r\n                data.repository_url = repositoryUrlControl.value;\r\n                data.token = tokenControl.value;\r\n                data.project_path = projectPathControl.value;\r\n                data.auto_discover_groups = autoDiscoverGroupsControl.value;\r\n                data.include_cmdb = includeCmdbControl.value;\r\n                data.include_documentation = includeDocumentationControl.value;\r\n                data.include_jobs = includeJobsControl.value;\r\n                data.use_ai_analysis = useAIAnalysisControl.value;\r\n            }\r\n            submitButton.click();\r\n        } else {\r\n            // Local environment - just log\r\n            console.log('Datos a enviar:', repositoryUrlControl.value);\r\n        }\r\n    }\r\n\r\n    // Attach click event to button\r\n    const sendButton = document.getElementById('startBtn');\r\n    if (sendButton) {\r\n        console.log('Botón startBtn encontrado');\r\n        sendButton.addEventListener('click', async (e) => {\r\n            e.preventDefault();\r\n            console.log('Click detectado en startBtn');\r\n            processUserMessage();\r\n        });\r\n    } else {\r\n        console.error('No se encontró el botón startBtn');\r\n    }\r\n    \r\n    loadFormData();\r\n});","key":"serverSideJavaScript","type":"customjs","scriptName":"Custom Javascript","input":true,"tableView":false,"label":"Server-side JavaScript","validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"data":{"content":"$(document).ready(async function () {\r\n    $('.formio-component-button').hide();\r\n    $('.alerts-status-bar').hide();\r\n    const repositoryUrlControl = document.getElementById('source_url');\r\n    const tokenControl = document.getElementById('token');\r\n    const projectPathControl = document.getElementById('project_path');\r\n    const autoDiscoverGroupsControl = document.getElementById('auto_discover_groups');\r\n    const includeCmdbControl = document.getElementById('include_cmdb');\r\n    const includeDocumentationControl = document.getElementById('include_documentation');\r\n    const includeJobsControl = document.getElementById('include_jobs');\r\n    const useAIAnalysisControl = document.getElementById('use_ai_analysis');\r\n    \r\n    function loadFormData(){\r\n      repositoryUrlControl.value = data.repository_url;\r\n      tokenControl.value = data.token;\r\n    }\r\n    \r\n    function metric(label, value){\r\n      return `<div class=\"metric\"><h3>${escapeHtml(label)}</h3><p>${value ?? 0}</p></div>`;\r\n    }\r\n    \r\n    function escapeHtml(s){\r\n      return (s==null?'':String(s)).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[c]));\r\n    }\r\n    \r\n    function processUserMessage() {\r\n        console.log('processUserMessage ejecutado');\r\n\r\n        // Check if we're in production environment\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[submit]\"]');\r\n\r\n        if (submitButton) {\r\n            // Production environment - use existing flow\r\n            if (typeof data !== 'undefined') {\r\n                data.repository_url = repositoryUrlControl.value;\r\n                data.token = tokenControl.value;\r\n                data.project_path = projectPathControl.value;\r\n                data.auto_discover_groups = autoDiscoverGroupsControl.value;\r\n                data.include_cmdb = includeCmdbControl.value;\r\n                data.include_documentation = includeDocumentationControl.value;\r\n                data.include_jobs = includeJobsControl.value;\r\n                data.use_ai_analysis = useAIAnalysisControl.value;\r\n            }\r\n            submitButton.click();\r\n        } else {\r\n            // Local environment - just log\r\n            console.log('Datos a enviar:', repositoryUrlControl.value);\r\n        }\r\n    }\r\n\r\n    // Attach click event to button\r\n    const sendButton = document.getElementById('startBtn');\r\n    if (sendButton) {\r\n        console.log('Botón startBtn encontrado');\r\n        sendButton.addEventListener('click', async (e) => {\r\n            e.preventDefault();\r\n            console.log('Click detectado en startBtn');\r\n            processUserMessage();\r\n        });\r\n    } else {\r\n        console.error('No se encontró el botón startBtn');\r\n    }\r\n    \r\n    loadFormData();\r\n});"},"jsProperties":{"first":false},"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":true,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":true,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"customConditional":"","id":"eqp43yo"},{"label":"Analizar","action":"submit","showValidations":false,"theme":"primary","size":"md","block":false,"leftIcon":"","rightIcon":"","shortcut":"","description":"","tooltip":"","customClass":"","tabindex":"","disableOnInvalid":true,"hidden":false,"autofocus":false,"disabled":false,"tableView":false,"modalEdit":false,"key":"submit","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"button","input":true,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","errorLabel":"","hideLabel":false,"