":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"rightIcon":"","block":false,"disableOnInvalid":false,"dataGridLabel":true,"id":"ekfeylq"},{"label":"\uD83D\uDCBE Guardar Configuración","type":"button","key":"save","action":"submit","theme":"primary","size":"lg","leftIcon":"fa fa-save","customClass":"w-100 mt-4","input":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","tableView":false,"modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"rightIcon":"","block":false,"disableOnInvalid":false,"dataGridLabel":true,"id":"efvfj3"}],"outputs":3,"x":260,"y":620,"wires":[["d6413206.72c3d8"],["7587e49b.255d64"],["e7f85147.7e765"]]},{"id":"c09d6d59.a2ece8","type":"axetflows-view-action","z":"ff426f85.f0fea8","name":"","action":"redirect","redirectPage":"form-config-simple","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":350,"y":40,"wires":[]},{"id":"174321a6.060a56","type":"axetflows-view-action","z":"ff426f85.f0fea8","name":"","action":"redirect","redirectPage":"af85aade.cc55e8","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":350,"y":80,"wires":[]},{"id":"583d2520.6dc6ec","type":"axetflows-view-action","z":"ff426f85.f0fea8","name":"","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":510,"y":120,"wires":[]},{"id":"b462e7f6.8526e","type":"function","z":"ff426f85.f0fea8","name":"Load error view","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Load Error View\" - VERSIÓN CORRECTA CON UPDATE\n// Output 3 del form-error-view\n// ═══════════════════════════════════════════════════════════════\n\nnode.warn('═══════════════════════════════════════');\nnode.warn('\uD83D\uDCCB LOAD ERROR VIEW');\nnode.warn('═══════════════════════════════════════');\n\n// ═══════════════════════════════════════════════════════════════\n// 1️⃣ LEER DATOS CON PRIORIDAD\n// ═══════════════════════════════════════════════════════════════\n\n// Prioridad 1: msg.onInitSubmission (viene después del redirect)\nlet errorIcon = null;\nlet errorTitle = null;\nlet errorSummary = null;\nlet suggestions = null;\nlet jobId = null;\nlet timestamp = null;\nlet errorFull = null;\n\nif (msg.onInitSubmission) {\n    errorIcon = msg.onInitSubmission.error_icon;\n    errorTitle = msg.onInitSubmission.error_title;\n    errorSummary = msg.onInitSubmission.error_summary;\n    suggestions = msg.onInitSubmission.suggestions;\n    jobId = msg.onInitSubmission.job_id;\n    timestamp = msg.onInitSubmission.timestamp;\n    errorFull = msg.onInitSubmission.error_full;\n\n    if (errorIcon) {\n        node.warn('\uD83D\uDCE5 Datos obtenidos desde msg.onInitSubmission');\n    }\n}\n\n// Prioridad 2: msg.submission (compatibilidad)\nif (!errorIcon && msg.submission) {\n    errorIcon = msg.submission.error_icon;\n    errorTitle = msg.submission.error_title;\n    errorSummary = msg.submission.error_summary;\n    suggestions = msg.submission.suggestions;\n    jobId = msg.submission.job_id;\n    timestamp = msg.submission.timestamp;\n    errorFull = msg.submission.error_full;\n\n    if (errorIcon) {\n        node.warn('\uD83D\uDCE5 Datos obtenidos desde msg.submission');\n    }\n}\n\n// Valores por defecto finales\nerrorIcon = errorIcon || '❌';\nerrorTitle = errorTitle || 'Error Desconocido';\nerrorSummary = errorSummary || 'No se pudo cargar la información del error.';\nsuggestions = suggestions || [\n    'Contacte al administrador del sistema',\n    'Revise los logs para más información'\n];\njobId = jobId || 'N/A';\ntimestamp = timestamp || new Date().toLocaleString('es-ES');\nerrorFull = errorFull || 'Sin detalles disponibles';\n\n// ═══════════════════════════════════════════════════════════════\n// 2️⃣ GENERAR HTML PARA SUGERENCIAS\n// ═══════════════════════════════════════════════════════════════\n\nlet suggestionsHTML = '';\nif (suggestions && Array.isArray(suggestions)) {\n    suggestionsHTML = '<ul style=\"margin: 0; padding-left: 20px; line-height: 1.6;\">';\n    suggestions.forEach(suggestion => {\n        suggestionsHTML += `<li style=\"margin-bottom: 10px;\">${suggestion}</li>`;\n    });\n    suggestionsHTML += '</ul>';\n} else {\n    suggestionsHTML = '<p>No hay sugerencias disponibles.</p>';\n}\n\n// ═══════════════════════════════════════════════════════════════\n// 3️⃣ GUARDAR EN msg.onInitSubmission (para futuros redirects)\n// ═══════════════════════════════════════════════════════════════\n\nif (!msg.onInitSubmission) {\n    msg.onInitSubmission = {};\n}\n\nmsg.onInitSubmission.error_icon = errorIcon;\nmsg.onInitSubmission.error_title = errorTitle;\nmsg.onInitSubmission.error_summary = errorSummary;\nmsg.onInitSubmission.suggestions = suggestions;\nmsg.onInitSubmission.suggestions_html = suggestionsHTML;\nmsg.onInitSubmission.job_id = jobId;\nmsg.onInitSubmission.timestamp = timestamp;\nmsg.onInitSubmission.error_full = errorFull;\n\n// ═══════════════════════════════════════════════════════════════\n// 4️⃣ GUARDAR EN msg.submission (para el formulario)\n// ═══════════════════════════════════════════════════════════════\n\nif (!msg.submission) {\n    msg.submission = {};\n}\n\nmsg.submission.error_icon = errorIcon;\nmsg.submission.error_title = errorTitle;\nmsg.submission.error_summary = errorSummary;\nmsg.submission.suggestions = suggestions;\nmsg.submission.suggestions_html = suggestionsHTML;\nmsg.submission.job_id = jobId;\nmsg.submission.timestamp = timestamp;\nmsg.submission.error_full = errorFull;\n\n// ═══════════════════════════════════════════════════════════════\n// 5️⃣ LOGS DE DEBUG\n// ═══════════════════════════════════════════════════════════════\n\nnode.warn('✅ Datos preparados:');\nnode.warn(`   Icon: ${errorIcon}`);\nnode.warn(`   Title: ${errorTitle}`);\nnode.warn(`   Job ID: ${jobId}`);\nnode.warn(`   Suggestions: ${suggestions.length} items`);\nnode.warn(`   Suggestions HTML: ${suggestionsHTML.length} chars`);\nnode.warn('   ✅ Guardado en msg.onInitSubmission');\nnode.warn('   ✅ Guardado en msg.submission');\nnode.warn('═══════════════════════════════════════');\n\nnode.status({\n    fill: 'red',\n    shape: 'dot',\n    text: errorTitle\n});\n\n// ⭐ RETORNAR msg (nodo sincrónico)\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":320,"y":120,"wires":[["f7495436.36786","583d2520.6dc6ec"]]},{"id":"f7495436.36786","type":"debug","z":"ff426f85.f0fea8","name":"","active":true,"tosidebar":true,"console":false,"tos