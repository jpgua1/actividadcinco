"label":"✅ Enviar Feedback","showValidations":true,"tableView":false,"key":"submit","type":"button","input":true,"customClass":"btn btn-primary","theme":"primary","action":"submit","size":"lg","block":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"hideLabel":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"disableOnInvalid":false,"dataGridLabel":true,"id":"eqhclfi","leftIcon":"","rightIcon":""}]},"buttons":[{"label":"✅ Enviar Feedback","showValidations":true,"tableView":false,"key":"submit","type":"button","input":true,"customClass":"btn btn-primary","theme":"primary","action":"submit","size":"lg","block":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"hideLabel":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"disableOnInvalid":false,"dataGridLabel":true,"id":"eqhclfi","leftIcon":"","rightIcon":""}],"outputs":2,"x":170,"y":80,"wires":[["9ab90d1.1c0e47"],["d34f461d.3306e8"]]},{"id":"26b4278d.d3366","type":"axetflows-view-action","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"feed","action":"redirect","redirectPage":"2313a2ab.e48896","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":810,"y":100,"wires":[]},{"id":"ae7b732b.44137","type":"axetflows-view-action","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"done","action":"redirect","redirectPage":"aa8d169a.484a18","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":930,"y":140,"wires":[]},{"id":"9690b63d.28bcf","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Preparar feed","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Preparar feed\" - CORREGIDO\n// ═══════════════════════════════════════════════════════════════\n\nconst jobData = msg.payload;\nconst result = jobData.result || {};\n\nconst iteration = result.iteration || 1;\nconst filesGenerated = result.files_generated || [];\nconst modifications = result.modifications || [];\nconst feedback_point = result.feedback_point || 'unknown';\n\nnode.warn('\uD83D\uDCE5 Preparando datos de feedback:');\nnode.warn(`   Iteración: ${iteration}`);\nnode.warn(`   Archivos generados: ${filesGenerated.length}`);\nnode.warn(`   Modificaciones: ${modifications.length}`);\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCDD CONSTRUIR DISPLAY DE TAREAS\n// ═══════════════════════════════════════════════════════════════\nlet tasksDisplay = `<strong>\uD83D\uDCCB ITERACIÓN ${iteration}</strong><br><br>`;\n\nif (filesGenerated.length > 0) {\n    tasksDisplay += `<strong>\uD83D\uDCC1 Archivos generados (${filesGenerated.length}):</strong><br>`;\n    filesGenerated.forEach((file, idx) => {\n        tasksDisplay += `&nbsp;&nbsp;${idx + 1}. ${file}<br>`;\n    });\n    tasksDisplay += `<br>`;\n}\n\nif (modifications.length > 0) {\n    tasksDisplay += `<strong>\uD83D\uDD27 Modificaciones aplicadas:</strong><br>`;\n    modifications.forEach((mod, idx) => {\n        tasksDisplay += `&nbsp;&nbsp;${idx + 1}. <strong>${mod.filepath}</strong><br>`;\n        if (mod.changes && mod.changes.length > 0) {\n            mod.changes.slice(0, 3).forEach(change => {\n                const shortChange = change.substring(0, 80) + (change.length > 80 ? '...' : '');\n                tasksDisplay += `&nbsp;&nbsp;&nbsp;&nbsp;- ${shortChange}<br>`;\n            });\n        }\n    });\n}\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ GUARDAR EN msg.submission Y msg (CRÍTICO)\n// ═══════════════════════════════════════════════════════════════\nif (!msg.submission) {\n    msg.submission = {};\n}\n\n// ⭐ GUARDAR job_id desde el nodo anterior\nconst jobId =\n    (msg.submission && msg.submission.job_id) ||\n    msg.job_id ||\n    jobData.job_id;\n\n// ⭐ GUARDAR EN msg.submission (para después del view-action)\nmsg.submission.job_id = jobId;\nmsg.submission.iteration = iteration;\nmsg.submission.tasks_display = tasksDisplay;\n\n// ⭐⭐⭐ CRÍTICO: TAMBIÉN GUARDAR EN msg DIRECTO (sobrevive al view-action)\nmsg.job_id = jobId;\nmsg.iteration = iteration;\nmsg.tasks_display = tasksDisplay;\n\nnode.warn('✅ Datos guardados en msg.submission:');\nnode.warn(`   job_id: ${jobId}`);\nnode.warn(`   iteration: ${iteration}`);\nnode.warn(`   tasks_display: ${tasksDisplay.length} caracteres`);\nnode.warn(`   Preview: ${tasksDisplay.substring(0, 100)}...`);\n\n// ⭐ RETORNAR msg\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":400,"y":100,"wires":[["3bd3428f.479786"]]},{"id":"ea027fa5.e94b4","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Preparar descarga","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Preparar datos para resultado final - VERSIÓN CORREGIDA\"\n// ═══════════════════════════════════════════════════════════════\n\nconst jobData = msg.payload;\nconst result = jobData.result || {};\nconst tokenSummary = result.token_usage || {};\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCA EXTRAER DATOS DEL RESULTADO\n// ═══════════════════════════════════════════════════════════════\nconst jobId = jobData.job_id || msg.job_id || (msg.submission && msg.submission.job_id);\n\nconst downloadUrl = `http://localhost:8000/api/v1/download/${jobId}`;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ GUARDAR EN BACKUP (para recuperar después del ZIP)\n// ═══════════════════════════════════════════════════════════════\nconst dataBackup = {  \n  job_id: jobId,\n  inventory: jobData.inventory,\n  download_url: downloadUrl\n};\n\n// Guardar en flow (persiste entre nodos)\nflow.set('jobDataBackup', dataBackup);\nnode.warn('   ✅ Datos guardados en flow.jobDataBackup');\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐⭐⭐ CRÍTICO: GUARDAR EN msg Y msg.onInitSubmission\n// ═══════════════════════════════════════════════════════════════\n\n// 1️⃣ Guardar en msg (para nodos siguientes en ESTE flujo)\nmsg.job_id = jobId;\nmsg.download_url = downloadUrl;\n\n// ⭐ GUARDAR BACKUP EN msg (para recuperar después)\nmsg.jobDataBackup = dataBackup;\n\n// 2️⃣ Guardar en msg.submission (para compatibilidad)\nif (!msg.submission) {\n  msg.submission = {};\n}\nmsg.submission.job_id = jobId;\nmsg.submission.download_url = downloadUrl;\nmsg.submission.jobDataBackup = dataBackup;\n\n// 3️⃣ ⭐ GUARDAR EN msg.onInitSubmission (para el view-action con Redirect)\nif (!msg.onInitSubmission) {\n  msg.onInitSubmission = {};\n}\nmsg.onInitSubmission.job_id = jobId;\nmsg.onInitSubmission.download_url = downloadUrl;\nmsg.onInitSubmission.inventory = jobData.inventory;\n\n// ⭐ GUARDAR BACKUP EN onInitSubmission\nmsg.onInitSubmission.jobDataBackup = dataBackup;\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCE6 PREPARAR PAYLOAD CON TODOS LOS DATOS\n// ═══════════════════════════════════════════════════════════════\nmsg.payload = {\n  success: true,\n  job_id: jobId,\n  download_url: downloadUrl,\n  jobDataBackup: dataBackup,\n  response: msg.payload\n};\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCB DEBUG - MOSTRAR QUÉ SE PREPARÓ\n// ═══════════════════════════════════════════════════════════════\nnode.warn('✅ Datos preparados para resultado final:');\nnode.warn(`   msg.onInitSubmission.job_id: ${msg.onInitSubmission.job_id}`);\nnode.warn(`   msg.onInitSubmission.download_url: ${msg.onInitSubmission.download_url}`);\nnode.warn(`   msg.jobDataBackup en flow: ✓`);\n\n// ⭐ RETORNAR msg\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":710,"y":140,"wires":[["ae7b732b.44137"]]},{"id":"3bd3428f.479786","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"cargar datos feed","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"cargar datos feed\" - VERSIÓN FINAL CORRECTA\n// ═══════════════════════════════════════════════════════════════\n\n// ⭐ LEER DESDE msg (viene de Preparar feed)\nconst tasksDisplay =\n    msg.tasks_display ||\n    (msg.submission && msg.submission.tasks_display) ||\n    '⚠️ No hay datos de tareas disponibles';\n\nconst iteration =\n    msg.iteration ||\n    (msg.submission && msg.submission.iteration) ||\n    1;\n\nconst jobId =\n    msg.job_id ||\n    (msg.submission && msg.submission.job_id) ||\n    '';\n\nnode.warn('\uD83D\uDCE5 Cargando datos del formulario feedback:');\nnode.warn(`   job_id: ${jobId}`);\nnode.warn(`   iteration: ${iteration}`);\nnode.warn(`   tasks_display: ${tasksDisplay.length} caracteres`);\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐⭐⭐ CRÍTICO: USAR msg.onInitSubmission (para \"Redirect page\")\n// ═══════════════════════════════════════════════════════════════\nif (!msg.onInitSubmission) {\n    msg.onInitSubmission = {};\n}\n\n// ⭐ POBLAR msg.onInitSubmission (datos para INICIALIZAR el nuevo formulario)\nmsg.onInitSubmission.tasks_display = tasksDisplay;\nmsg.onInitSubmission.iteration = iteration;\nmsg.onInitSubmission.job_id = jobId;\n\n// ⭐ INICIALIZAR CAMPOS DEL FORMULARIO (valores por defecto)\nif (!msg.onInitSubmission.feedback_text) {\n    msg.onInitSubmission.feedback_text = '';\n}\nif (msg.onInitSubmission.approve_without_feedback === undefined) {\n    msg.onInitSubmission.approve_without_feedback = false;\n}\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCB DEBUG\n// ═══════════════════════════════════════════════════════════════\nnode.warn('✅ Datos preparados en msg.onInitSubmission:');\nnode.warn(`   msg.onInitSubmission.job_id: ${msg.onInitSubmission.job_id}`);\nnode.warn(`   msg.onInitSubmission.iteration: ${msg.onInitSubmission.iteration}`);\nnode.warn(`   msg.onInitSubmission.tasks_display.length: ${msg.onInitSubmission.tasks_display.length}`);\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":610,"y":100,"wires":[["26b4278d.d3366"]]},{"id":"7d9d5d59.1a73cc","type":"axetflows-view-action","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"","action":"redirect","redirectPage":"29dd86d6.c24bf2","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":570,"y":180,"wires":[]},{"id":"d07cd12c.955eb","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Preparar error","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Preparar Vista de Error - CON onInitSubmission\"\n// ═══════════════════════════════════════════════════════════════\n\nconst jobData = msg.payload;\n\n// ═══════════════════════════════════════════════════════════════\n// 1️⃣ EXTRAER INFORMACIÓN DEL ERROR\n// ═══════════════════════════════════════════════════════════════\n\nconst errorMessage = jobData.error || jobData.message || 'Error desconocido';\nconst jobId = jobData.job_id || 'N/A';\n\n// ═══════════════════════════════════════════════════════════════\n// 2️⃣ DETERMINAR TIPO DE ERROR Y SUGERENCIAS\n// ═══════════════════════════════════════════════════════════════\n\nlet errorIcon = '❌';\nlet errorTitle = 'Error en la Generación de Código';\nlet errorSummary = errorMessage.substring(0, 300);\nlet suggestions = [];\n\n// Detectar errores de autenticación Azure\nif (errorMessage.includes('Authentication failed') ||\n    errorMessage.includes('Unable to get authority configuration')) {\n\n    errorIcon = '\uD83D\uDD10';\n    errorTitle = 'Error de Autenticación Azure';\n    errorSummary = 'Las credenciales de Azure no son válidas. Verifique su configuración.';\n    suggestions = [\n        'Verifique que el <strong>Tenant ID</strong> sea correcto (formato: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)',\n        'Compruebe que el <strong>App ID</strong> (Client ID) sea válido',\n        'Asegúrese de que el <strong>Client Secret</strong> no haya expirado',\n        'Confirme que tiene permisos en Azure AD para usar la aplicación',\n        'Revise que la configuración en el formulario Azure esté completa'\n    ];\n\n} else if (errorMessage.includes('bearer token')) {\n\n    errorIcon = '\uD83D\uDD11';\n    errorTitle = 'Error Generando Token de Azure';\n    errorSummary = 'No se pudo obtener un token de autenticación de Azure.';\n    suggestions = [\n        'Verifique que las credenciales Azure sean correctas',\n        'Asegúrese de que el <strong>Client Secret</strong> sea válido',\n        'Compruebe que el servicio Azure AD esté disponible',\n        'Revise los permisos de la aplicación en Azure Portal'\n    ];\n\n} else if (errorMessage.includes('AZURE_TENANT_ID') ||\n    errorMessage.includes('AZURE_APP_ID') ||\n    errorMessage.includes('Missing required')) {\n\n    errorIcon = '⚙️';\n    errorTitle = 'Configuración Azure Incompleta';\n    errorSummary = 'Faltan credenciales de Azure requeridas para la generación de código.';\n    suggestions = [\n        'Complete el formulario de <strong>Configuración Azure</strong>',\n        'Asegúrese de proporcionar todos los campos obligatorios',\n        'Verifique que el archivo .env tenga valores por defecto válidos',\n        'Contacte al administrador si no tiene acceso a las credenciales'\n    ];\n\n} else if (errorMessage.includes('Azure')) {\n\n    errorIcon = '☁️';\n    errorTitle = 'Error de Azure OpenAI';\n    errorSummary = errorMessage.substring(0, 300);\n    suggestions = [\n        'Verifique la conectividad con Azure OpenAI',\n        'Compruebe que los nombres de los modelos sean correctos',\n        'Asegúrese de que el endpoint de Azure esté disponible',\n        'Revise que tenga cuota disponible en su suscripción de Azure'\n    ];\n\n} else if (errorMessage.includes('timeout') || errorMessage.includes('ETIMEDOUT')) {\n\n    errorIcon = '⏱️';\n    errorTitle = 'Timeout en la Operación';\n    errorSummary = 'La operación tardó demasiado tiempo y se canceló.';\n    suggestions = [\n        'Intente nuevamente en unos minutos',\n        'Verifique su conexión a internet',\n        'Reduzca el tamaño de los archivos a procesar',\n        'Contacte al administrador si el problema persiste'\n    ];\n\n} else {\n\n    // Error genérico\n    suggestions = [\n        'Revise los logs del sistema para más información',\n        'Verifique que todos los servicios estén funcionando correctamente',\n        'Intente nuevamente la operación',\n        'Contacte al soporte técnico si el problema continúa'\n    ];\n}\n\n// ═══════════════════════════════════════════════════════════════\n// 3️⃣ PREPARAR DATOS PARA onInitSubmission\n// ═══════════════════════════════════════════════════════════════\n\n// ⭐ CLAVE: Usar onInitSubmission para que los datos persistan en el redirect\nmsg.onInitSubmission = {\n    error_icon: errorIcon,\n    error_title: errorTitle,\n    error_summary: errorSummary,\n    suggestions: suggestions,\n    job_id: jobId,\n    timestamp: new Date().toLocaleString('es-ES', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit'\n    }),\n    error_full: errorMessage\n};\n\n// ═══════════════════════════════════════════════════════════════\n// 4️⃣ CONFIGURAR REDIRECCIÓN A LA VISTA DE ERROR\n// ═══════════════════════════════════════════════════════════════\n\nmsg._viewAction = {\n    action: 'redirect',\n    view: 'form-error-view',  // ⭐ ID del form de error\n    message: errorTitle,\n    messageType: 'danger'\n};\n\nnode.warn('═══════════════════════════════════════');\nnode.warn('\uD83D\uDD34 PREPARANDO VISTA DE ERROR');\nnode.warn('═══════════════════════════════════════');\nnode.warn(`Icon: ${errorIcon}`);\nnode.warn(`Title: ${errorTitle}`);\nnode.warn(`Summary: ${errorSummary}`);\nnode.warn(`Job ID: ${jobId}`);\nnode.warn(`Suggestions: ${suggestions.length} items`);\nnode.warn('═══════════════════════════════════════');\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":400,"y":180,"wires":[["7d9d5d59.1a73cc"]]},{"id":"4d1c49c2.ae0a98","type":"switch","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Verificar status","property":"payload.status","propertyType":"msg","rules":[{"t":"eq","v":"processing","vt":"str"},{"t":"eq","v":"running","vt":"str"},{"t":"eq","v":"pending","vt":"str"},{"t":"eq","v":"awaiting_feedback","vt":"str"},{"t":"eq","v":"completed","vt":"str"},{"t":"eq","v":"failed","vt":"str"},{"t":"else"}],"checkall":"false","repair":false,"outputs":7,"x":180,"y":120,"wires":[["a986b26a.234198"],["a986b26a.234198"],["a986b26a.234198"],["9690b63d.28bcf"],["239c1dcd.e49022"],["d07cd12c.955eb"],["d07cd12c.955eb"]]},{"id":"a986b26a.234198","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Preparar vista progreso","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Preparar vista progreso\" - VERSIÓN PROFESIONAL MODERNA\n// ═══════════════════════════════════════════════════════════════\n\n// \uD83D\uDCCA DEBUG: Mostrar datos completos\nnode.warn('═══════════════════════════════════════════════════════════════');\nnode.warn('\uD83D\uDD0D DEBUG - DATOS DE PROGRESO');\nnode.warn('═══════════════════════════════════════════════════════════════');\nnode.warn(JSON.stringify(msg.payload, null, 2));\n\n// Leer datos desde msg.payload\nconst jobData = msg.payload;\nconst result = jobData.result || {};\n\nconst progress = Math.round((jobData.progress || 0) * 100);\nconst message = jobData.message || 'Procesando...';\nconst jobId = jobData.job_id || msg.job_id;\nconst iteration = jobData.result?.iteration ?? 1;\nconst status = jobData.status || 'processing';\nconst platform = jobData.platform;\n\nconst currentTask = result.current_task || 'Inicializando...';\nconst tasksCompleted = jobData.tasks_completed || [];\nconst tasksInProgress = jobData.tasks_in_progress || [];\nconst tasksPending = jobData.tasks_pending || [];\nconst filesGenerated = result.files_generated || [];\n\nnode.warn('═══════════════════════════════════════════════════════════════');\nnode.warn(`✅ Job: ${jobId} | Iteration: ${iteration} | Progress: ${progress}%`);\nnode.warn(`\uD83D\uDCDD Tareas: ✓${tasksCompleted.length} ⏳${tasksInProgress.length} ⏰${tasksPending.length}`);\nnode.warn('═══════════════════════════════════════════════════════════════');\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83C\uDFA8 CONSTRUIR HTML PROFESIONAL CON DISEÑO MODERNO\n// ═══════════════════════════════════════════════════════════════\n\nconst html = `\n<style>\n  :root{\n    --bg: #0b1220;\n    --bg-alt: #131d30;\n    --panel: #1e2a3d;\n    --panel-soft: #25364b;\n    --border: #2f455e;\n    --border-soft:#1d2a3b;\n    --accent: #6366f1;\n    --accent-hover:#5255e9;\n    --accent-gradient: linear-gradient(135deg,#6366f1 0%,#818cf8 55%,#a5b4fc 100%);\n    --danger:#dc2626;\n    --success:#16a34a;\n    --warning:#f59e0b;\n    --text:#f1f5f9;\n    --text-dim:#94a3b8;\n    --radius:14px;\n    --shadow:0 4px 18px -4px rgba(0,0,0,.4),0 2px 6px -2px rgba(0,0,0,.35);\n    --trans:0.18s cubic-bezier(.4,.2,.2,1);\n  }\n  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }\n  @keyframes slideIn { from { transform: translateX(-20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }\n  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }\n  \n  body{background:radial-gradient(circle at 25% 15%,#142235,#0b1220 55%) fixed;color:var(--text);line-height:1.5;min-height:100vh;}\n\n  .progress-container {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    background: linear-gradient(135deg, #667eea08 0%, #764ba208 100%);\n    border-radius: 1.5rem;\n    padding: 2rem;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.08);\n    border: 1px solid #e5e7eb;\n  }\n  \n  .progress-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 2rem;\n    gap: 1rem;\n  }\n  \n  .progress-icon {\n    font-size: 3rem;\n    animation: float 3s ease-in-out infinite;\n  }\n  \n  .progress-title {\n    flex: 1;\n  }\n  \n  .progress-title h2 {\n    margin: 0 0 0.25rem 0;\n    font-size: 1.75rem;\n    font-weight: 700;\n    color:var(--text-dim);\n    letter-spacing: -0.5px;\n  }\n  \n  .progress-title p {\n    margin: 0;\n    font-size: 0.95rem;\n    color:var(--text-dim);\n  }\n  \n  .iteration-badge {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    color: white;\n    padding: 0.5rem 1rem;\n    border-radius: 2rem;\n    font-weight: 600;\n    font-size: 0.875rem;\n    box-shadow: 0 4px 12px rgba(102,126,234,0.3);\n  }\n  \n  .progress-bar-container {\n    margin: 2rem 0;\n  }\n  \n  .progress-label {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 0.75rem;\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: #374151;\n  }\n  \n  .progress-bar {\n    background: #e5e7eb;\n    border-radius: 1rem;\n    height: 12px;\n    overflow: hidden;\n    box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);\n  }\n  \n  .progress-fill {\n    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);\n    height: 100%;\n    width: ${progress}%;\n    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n    box-shadow: 0 0 20px rgba(102,126,234,0.5);\n  }\n  \n  .progress-message {\n    text-align: center;\n    font-size: 1rem;\n    color: #555;\n    margin: 1.5rem 0;\n    font-weight: 500;\n    animation: slideIn 0.5s ease-out;\n  }\n  \n  .status-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n    gap: 1rem;\n    margin: 2rem 0;\n  }\n  \n  .status-card {\n    background:#102035;\n    border-radius: 1rem;\n    padding: 1.25rem;\n    border: 2px solid #e5e7eb;\n    transition: all 0.3s ease;\n  }\n  \n  .status-card:hover {\n    border-color: #667eea;\n    box-shadow: 0 4px 12px rgba(102,126,234,0.1);\n    transform: translateY(-2px);\n  }\n  \n  .status-card-title {\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: #6b7280;\n    margin: 0 0 0.5rem 0;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n  \n  .status-card-value {\n    font-size: 2rem;\n    font-weight: 700;\n    margin: 0;\n  }\n  \n  .completed .status-card-value { color: #10b981; }\n  .inprogress .status-card-value { color: #f59e0b; }\n  .pending .status-card-value { color: #6b7280; }\n  \n  .tasks-section {\n    margin: 2rem 0;\n    background:#102035;\n  }\n  \n  .tasks-title {\n    font-size: 1rem;\n    font-weight: 700;\n    color: #111827;\n    margin: 0 0 1rem 0;\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n  }\n  \n  .tasks-list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  \n  .task-item {\n    padding: 0.75rem 1rem;\n    margin: 0.5rem 0;\n    border-radius: 0.75rem;\n    font-size: 0.9rem;\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    animation: slideIn 0.4s ease-out;\n  }\n  \n  .task-item.completed {\n    background: #ecfdf5;\n    color: #065f46;\n    border-left: 4px solid #10b981;\n  }\n  \n  .task-item.inprogress {\n    background: #fffbf0;\n    color: #92400e;\n    border-left: 4px solid #f59e0b;\n  }\n  \n  .task-item.pending {\n    background: #f3f4f6;\n    color: #6b7280;\n    border-left: 4px solid #d1d5db;\n  }\n  \n  .task-icon {\n    font-weight: 600;\n    min-width: 1.25rem;\n  }\n  \n  .task-inprogress-dot {\n    display: inline-block;\n    width: 8px;\n    height: 8px;\n    background: #f59e0b;\n    border-radius: 50%;\n    animation: pulse 1.5s infinite;\n    margin-right: 0.5rem;\n  }\n  \n  .files-section {\n    background: white;\n    border-radius: 1rem;\n    padding: 1.5rem;\n    border: 2px solid #e5e7eb;\n    margin-top: 1.5rem;\n  }\n  \n  .files-title {\n    font-size: 1rem;\n    font-weight: 700;\n    color: #111827;\n    margin: 0 0 1rem 0;\n  }\n  \n  .files-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n    gap: 0.75rem;\n  }\n  \n  .file-item {\n    padding: 0.75rem;\n    background: #f0f4ff;\n    border-radius: 0.75rem;\n    font-size: 0.8rem;\n    color: #667eea;\n    font-family: 'Monaco', monospace;\n    word-break: break-all;\n    border: 1px solid #bfdbfe;\n    transition: all 0.3s ease;\n  }\n  \n  .file-item:hover {\n    background: #eff6ff;\n    border-color: #667eea;\n  }\n</style>\n\n<div class=\"progress-container\">\n  <!-- Header -->\n  <div class=\"progress-header\">\n    <div>\n      <div class=\"progress-icon\">⚙️</div>\n    </div>\n    <div class=\"progress-title\">\n      <h2>Generando Análisis de Repositorio</h2>\n      <p>Plataforma: ${platform}</p>\n    </div>\n  </div>\n\n  <!-- Progress Bar -->\n  <div class=\"progress-bar-container\">\n    <div class=\"progress-label\">\n      <span>Progreso General</span>\n      <strong>${progress}%</strong>\n    </div>\n    <div class=\"progress-bar\">\n      <div class=\"progress-fill\"></div>\n    </div>\n  </div>\n\n  <!-- Status Cards -->\n  <div class=\"status-grid\">\n    <div class=\"status-card completed\">\n      <div class=\"status-card-title\">✅ Completadas</div>\n      <p class=\"status-card-value\">${tasksCompleted}</p>\n    </div>\n    <div class=\"status-card inprogress\">\n      <div class=\"status-card-title\">⏳ En Progreso</div>\n      <p class=\"status-card-value\">${tasksInProgress}</p>\n    </div>\n    <div class=\"status-card pending\">\n      <div class=\"status-card-title\">⏰ Pendientes</div>\n      <p class=\"status-card-value\">${tasksPending}</p>\n    </div>\n  </div>\n\n  <!-- Current Task -->\n  <div style=\"background: white; border-radius: 1rem; padding: 1.25rem; border-left: 4px solid #667eea; margin: 1.5rem 0;\">\n    <p style=\"margin: 0; font-size: 0.875rem; color: #6b7280; font-weight: 600; text-transform: uppercase;\">TAREA ACTUAL</p>\n    <p style=\"margin: 0.5rem 0 0 0; font-size: 1.1rem; color: #111827; font-weight: 600;\">${message}</p>\n  </div>  \n</div>\n`;\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCBE GUARDAR EN msg PARA MOSTRAR EN LA VISTA\n// ═══════════════════════════════════════════════════════════════\n\ndelete msg.onInitSubmission;\n\nmsg.onInitSubmission = {\n    progress_html: html,\n    job_id: jobId,\n    progress_value: progress,\n    current_status: status,\n    iteration: iteration,\n    timestamp: Date.now()\n};\n\nif (!msg.submission) {\n    msg.submission = {};\n}\n\nmsg.submission.progress_html = html;\nmsg.submission.iteration = iteration;\n\nnode.warn('✅ Vista de progreso profesional preparada');\nnode.warn(`   Iteration: ${iteration} | Progress: ${progress}% | Tasks: ${tasksCompleted.length}+${tasksInProgress.length}+${tasksPending.length}`);\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":450,"y":20,"wires":[["6c9edb10.9c06dc"]]},{"id":"6c9edb10.9c06dc","type":"axetflows-view-action","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Mostrar progreso","action":"redirect","redirectPage":"5cfa3242.5bc3dc","downloadFile":false,"fileName":"","message":"","x":750,"y":20,"wires":[]},{"id":"239c1dcd.e49022","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Cargar datos resultado","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"3. Guardar job_id e iniciar polling - CORREGIDO\"\n// ═══════════════════════════════════════════════════════════════\n\nconst generateResponse = msg.payload;\nconst axios = global.get('axios') || require('axios');\n\nnode.warn('\uD83D\uDCE5 Generate response: ' + JSON.stringify(generateResponse));\n\nconst jobId = generateResponse.job_id;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ CAMBIO: GUARDAR EN msg.submission EN LUGAR DE flow.set()\n// ═══════════════════════════════════════════════════════════════\nif (!msg.submission) {\n    msg.submission = {};\n}\n\n// ⭐ GUARDAR job_id EN msg.submission (ÚNICO POR USUARIO)\nmsg.submission.job_id = jobId;\n\n// También guardarlo directamente en msg para el siguiente nodo HTTP request\nmsg.job_id = jobId;\n\nnode.status({\n    fill: 'yellow',\n    shape: 'ring',\n    text: `Job ${jobId.substring(0, 8)}... Cargando datos resultado`\n});\n\nnode.warn(`✅ job_id guardado en msg.submission: ${jobId}`);\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDD04 PREPARAR PARA POLLING (HTTP REQUEST)\n// ═══════════════════════════════════════════════════════════════\nmsg.payload = {\n    job_id: jobId\n};\n\nconst jobUrl = `http://localhost:8000/api/v1/jobs/${jobId}/analysis`;\n\naxios.get(jobUrl, {\n    timeout: 60000\n})\n    .then(response => {\n        const data = response.data;\n\n        node.warn('✅ /jobs response: ' + JSON.stringify(data));\n\n        // ═══════════════════════════════════════════════════════════\n        // ⭐ DETECTAR SI EL JOB FALLÓ\n        // ═══════════════════════════════════════════════════════════\n        if (data.status === 'failed') {\n            node.error('═══════════════════════════════════════');\n            node.error('❌ JOB FALLÓ');\n            node.error('═══════════════════════════════════════');\n            node.error(`Job ID: ${jobId}`);\n            node.error(`Mensaje: ${data.message || 'Sin mensaje'}`);\n            node.error(`Error: ${data.error || 'Sin detalles'}`);\n            node.error('═══════════════════════════════════════');\n\n            node.status({\n                fill: 'red',\n                shape: 'ring',\n                text: 'Job falló'\n            });\n\n            // ⭐ PREPARAR MENSAJE DE ERROR\n            const errorMessage = data.message || data.error || 'Error desconocido';\n            let userFriendlyError = errorMessage;\n\n            // ⭐ ERRORES ESPECÍFICOS DE BEARER TOKEN\n            if (errorMessage.includes('401') ||\n                errorMessage.includes('Unauthorized') ||\n                errorMessage.includes('Authentication failed')) {\n                userFriendlyError = '\uD83D\uDD10 Token de autenticación inválido o expirado. Por favor, cierre sesión y vuelva a iniciar sesión.';\n\n            } else if (errorMessage.includes('403') ||\n                errorMessage.includes('Forbidden')) {\n                userFriendlyError = '\uD83D\uDEAB No tiene permisos para usar Azure OpenAI con su cuenta actual.';\n\n            } else if (errorMessage.includes('Bearer token') ||\n                errorMessage.includes('bearer_token')) {\n                userFriendlyError = '\uD83D\uDD11 Error con el token de autenticación. Intente cerrar sesión y volver a entrar.';\n\n            } else if (errorMessage.includes('Azure OpenAI')) {\n                userFriendlyError = '☁️ Error de Azure OpenAI: ' + errorMessage.substring(0, 200);\n\n            } else if (errorMessage.includes('AZURE_OPENAI_ENDPOINT') ||\n                errorMessage.includes('AZURE_OPENAI_DEPLOYMENT')) {\n                userFriendlyError = '⚙️ Configuración de Azure incompleta en el servidor. Contacte al administrador.';\n            }\n\n            // ⭐ ENVIAR ERROR AL FRONTEND\n            msg.payload = {\n                success: false,\n                status: 'failed',\n                job_id: jobId,\n                error: errorMessage,\n                error_summary: userFriendlyError\n            };\n\n            msg._viewAction = {\n                action: 'update',\n                message: userFriendlyError,\n                messageType: 'danger'\n            };\n\n            node.send(msg);\n            return;\n        }\n\n        // ═══════════════════════════════════════════════════════════\n        // ✅ JOB EN PROGRESO O COMPLETADO\n        // ═══════════════════════════════════════════════════════════\n\n        node.status({\n            fill: data.status === 'completed' ? 'green' : 'yellow',\n            shape: 'dot',\n            text: `Status: ${data.status || 'unknown'}`\n        });\n\n        if (!msg.submission) msg.submission = {};\n        msg.submission.job_id = jobId;\n        msg.job_id = jobId;\n\n        msg.payload = data;\n\n        if (data.status === 'processing' || data.status === 'pending') {\n            msg._viewAction = {\n                action: 'update',\n                message: `⏳ ${data.message || 'Procesando...'}`,\n                messageType: 'info'\n            };\n        } else if (data.status === 'completed') {\n            msg._viewAction = {\n                action: 'update',\n                message: '✅ Código generado exitosamente',\n                messageType: 'success'\n            };\n        }\n\n        node.send(msg);\n    })\n    .catch(error => {\n        node.status({ fill: 'red', shape: 'ring', text: 'Error en /jobs' });\n\n        node.error('═══════════════════════════════════════');\n        node.error('❌ ERROR AL CONSULTAR JOB');\n        node.error('═══════════════════════════════════════');\n        node.error('Error: ' + error.message);\n\n        if (error.response) {\n            node.error('HTTP Status: ' + error.response.status);\n            node.error('Response Data: ' + JSON.stringify(error.response.data));\n        }\n\n        if (error.code === 'ECONNREFUSED') {\n            node.error('⚠️ No se puede conectar al servidor API');\n        }\n\n        if (error.code === 'ETIMEDOUT') {\n            node.error('⚠️ Timeout: El servidor tardó más de 60s en responder');\n        }\n\n        node.error('═══════════════════════════════════════');\n\n        msg.payload = {\n            success: false,\n            error: error.message,\n            error_detail: error.response?.data || null\n        };\n\n        msg._viewAction = {\n            action: 'update',\n            message: `❌ Error al consultar estado: ${error.message}`,\n            messageType: 'danger'\n        };\n\n        node.send(msg);\n    });\n\ndelete msg.onInitSubmission;\n\nreturn null;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":460,"y":140,"wires":[["ea027fa5.e94b4"]]},{"id":"eec44373.421608","type":"function","z":"01309592.14e4.4d5a.834c.655f33ccdfdb","name":"Preparar descarga","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Preparar datos para resultado final - VERSIÓN CORREGIDA\"\n// ═══════════════════════════════════════════════════════════════\n\nconst jobData = msg.payload;\nconst result = jobData.result || {};\nconst tokenSummary = result.token_usage || {};\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCA EXTRAER DATOS DEL RESULTADO\n// ═══════════════════════════════════════════════════════════════\nconst jobId = jobData.job_id || msg.job_id || (msg.submission && msg.submission.job_id);\nconst totalProyectos = jobData.analysis_data.analysis.total_projects;\nconst totalRamas = jobData.analysis_data.analysis.total_branches;\nconst ramas = jobData.analysis_data.projects[0].branches;\nconst tags = jobData.analysis_data.analysis.total_tags;\nconst releases = jobData.analysis_data.analysis.total_releases;\nconst artifacts = jobData.analysis_data.analysis.artifacts_catalog;\nconst ramasObsoletas = jobData.analysis_data.maintenance_report.ramas_obsoletas;\nconst tagsSinServer = jobData.analysis_data.maintenance_report.tags_no_semver;\nconst tagsObsoletos = jobData.analysis_data.maintenance_report.tags_obsoletos;\nconst artefactosPorExpirar = jobData.analysis_data.maintenance_report.artefactos_por_expirar;\nconst artefactoExpirados = jobData.analysis_data.maintenance_report.artefactos_expirados;\nconst projectName = jobData.analysis_data.projects[0].name;\nconst insights = jobData.analysis_data.insights;\n\nlet activas = 0;\nlet latentes = 0;\nlet inactivas = 0;\n\nfor (let index = 0; index < ramas.length; index++) {\n  const element = ramas[index];\n  switch (element.status) {\n    case 'ACTIVA':\n      activas++;\n      break;\n    case 'LATENTE':\n      latentes++;\n      break;\n    default:\n      inactivas++;\n      break;\n  }\n}\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCDD PREPARAR RESUMEN COMO TEXTO\n// ═══════════════════════════════════════════════════════════════\nconst summary = `\n\uD83C\uDFD7️  ESTRUCTURA DEL REPOSITORIO:\n  \uD83D\uDCE6 PROYECTOS: ${totalProyectos}\n  \uD83C\uDF3F RAMAS: ${totalRamas}\n    ✅ Activas (≤30 días): ${activas}\n    ⏸️ Latentes (30-90 días): ${latentes}\n    ❌ Inactivas (>90 días): ${inactivas}\n\n\uD83D\uDD16 VERSIONAMIENTO Y RELEASES: \n  \uD83C\uDFF7️ Tags totales:  ${tags}\n  \uD83D\uDCE6 Releases totales:  ${releases}\n  \uD83D\uDCDA Artefactos totales: ${artifacts?.length || 0} \n\n⚠️  ALERTAS DE MANTENIMIENTO:\n    \uD83D\uDDD1️  Ramas obsoletas: ${ramasObsoletas?.length || 0} \n    \uD83C\uDFF7️  Tags sin semver: ${tagsSinServer?.length || 0} \n    ⏳ Tags obsoletos: ${tagsObsoletos?.length || 0} \n    ⚠️  Artefactos por expirar: ${artefactosPorExpirar?.length || 0} \n    ❌ Artefactos expirados: ${artefactoExpirados?.length || 0} \n`;\n\nlet insight_summary = `No se realizo análisis inteligente`;\n\nif (insights.length > 0) {\n  const fase1 = insights[1].phase_1_delete_now;\n  const fase2 = insights[1].phase_2_review;\n  const fase3 = insights[1].phase_3_archive;\n\n  insight_summary = `  \n  \uD83D\uDCCB RESUMEN EJECUTIVO:\n  ${insights[0].executive_summary}\n      \uD83D\uDCCA Nivel de Riesgo: ${insights[0].risk_level}\n      ☢️ Mayor riesgo: ${insights[0].top_risks}\n      \uD83E\uDE7A Salud del Repositorio: ${insights[0].health_score} /100\n      \n      \uD83D\uDCA1 Recomendaciones Clave: \n      ${insights[0].recommendations}\n\n  \uD83E\uDDF9 PLAN DE LIMPIEZA INTELIGENTE\n  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n  \uD83D\uDD34 Fase 1 - BORRAR AHORA \n    Prioridad:   ${fase1.priority || 'CRÍTICA'}\n    \uD83D\uDCDD Justificación: \n      ${fase1.rationale}\n    \n    \uD83C\uDF3FRamas a Eliminar: \n    ${(fase1.branches || []).map(b => `      • ${b}`).join('\\n')}\n        \n    ⚠️Riesgos Identificados: ${(fase1.risks || ['Sin riesgos definidos']).join(', ')}\n    \uD83D\uDD70️Tiempo estimado: ${fase1.estimated_time || 'No especificado'}\n\n  \uD83D\uDFE0 FASE 2 - REVISAR PRIMERO\n    Prioridad: ${fase2.priority || 'ALTA'}\n    \uD83D\uDCDD Justificación:\n      ${fase2.rationale}\n    \n    \uD83C\uDF3FRamas a Revisar: \n    ${(fase2.branches || []).map(b => `      • ${b}`).join('\\n')}\n\n    \uD83D\uDCCB Pasos Recomendados:\n  ${(fase2.steps || []).map((s, i) => `      ${i + 1}. ${s}`).join('\\n')}  \n      \n  \uD83D\uDFE1 FASE 3 - ARCHIVAR\n    Prioridad: ${fase3.priority || 'MEDIA'}\n      \uD83D\uDCDD Justificación:\n      ${fase3.rationale || 'N/A'}\n\n      \uD83C\uDF3F Ramas a Archivar:\n      ${(fase3.branches || []).map(b => `      • ${b}`).join('\\n')}\n\n      \uD83E\uDD16 Automatización Sugerida: ${fase3.automation || 'Proceso manual recomendado'}\n  `;\n}\n\nconst downloadUrl = `http://localhost:8000/api/v1/download/${jobId}`;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ GUARDAR EN BACKUP (para recuperar después del ZIP)\n// ═══════════════════════════════════════════════════════════════\nconst dataBackup = {  \n  job_id: jobId,\n  summary: summary,\n  insight_summary: insight_summary,\n  download_url: downloadUrl\n};\n\n// Guardar en flow (persiste entre nodos)\nflow.set('jobDataBackup', dataBackup);\nnode.warn('   ✅ Datos guardados en flow.jobDataBackup');\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐⭐⭐ CRÍTICO: GUARDAR EN msg Y msg.onInitSubmission\n// ═══════════════════════════════════════════════════════════════\n\n// 1️⃣ Guardar en msg (para nodos siguientes en ESTE flujo)\nmsg.job_id = jobId;\nmsg.summary = summary;\nmsg.insight_summary = insight_summary;\nmsg.download_url = downloadUrl;\n\n// ⭐ GUARDAR BACKUP EN msg (para recuperar después)\nmsg.jobDataBackup = dataBackup;\n\n// 2️⃣ Guardar en msg.submission (para compatibilidad)\nif (!msg.submission) {\n  msg.submission = {};\n}\nmsg.submission.job_id = jobId;\nmsg.submission.summary = summary;\nmsg.submission.insight_summary = insight_summary;\nmsg.submission.download_url = downloadUrl;\nmsg.submission.jobDataBackup = dataBackup;\n\n// 3️⃣ ⭐ GUARDAR EN msg.onInitSubmission (para el view-action con Redirect)\nif (!msg.onInitSubmission) {\n  msg.onInitSubmission = {};\n}\nmsg.onInitSubmission.job_id = jobId;\nmsg.onInitSubmission.summary = summary;\nmsg.onInitSubmission.insight_summary = insight_summary;\nmsg.onInitSubmission.download_url = downloadUrl;\nmsg.onInitSubmission.projectPath = projectName;\n\n// ⭐ GUARDAR BACKUP EN onInitSubmission\nmsg.onInitSubmission.jobDataBackup = dataBackup;\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCE6 PREPARAR PAYLOAD CON TODOS LOS DATOS\n// ═══════════════════════════════════════════════════════════════\nmsg.payload = {\n  success: true,\n  summary: summary,\n  insight_summary: insight_summary,\n  job_id: jobId,\n  download_url: downloadUrl,\n  jobDataBackup: dataBackup,\n  response: msg.payload\n};\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCB DEBUG - MOSTRAR QUÉ SE PREPARÓ\n// ═══════════════════════════════════════════════════════════════\nnode.warn('✅ Datos preparados para resultado final:');\nnode.warn(`   msg.onInitSubmission.job_id: ${msg.onInitSubmission.job_id}`);\nnode.warn(`   msg.onInitSubmission.download_url: ${msg.onInitSubmission.download_url}`);\nnode.warn(`   msg.jobDataBackup en flow: ✓`);\n\n// ⭐ RETORNAR msg\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":710,"y":300,"wires":[[]]},{"id":"30ad814b.28d00e","type":"function","z":"ef48fe5e.6a89","name":"reporte","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Cargar datos del formulario resultado final - CORRECCIÓN\"\n// ═══════════════════════════════════════════════════════════════\n\nconst jobId =\n    msg.job_id ||\n    (msg.onInitSubmission && msg.onInitSubmission.job_id) ||\n    (msg.submission && msg.submission.job_id) ||\n    flow.get('job_id') ||\n    '';\n\nconst userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\n\nconst projectName = global.get(`project_name_${userId}`) || 'Proyecto Sin Nombre';\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCA INTENTAR OBTENER DATOS DEL RESULTADO\n// ═══════════════════════════════════════════════════════════════\n\nlet totalTokens = msg.final_total_tokens || msg.onInitSubmission?.total_tokens || 'Calculando...';\nlet cost = msg.final_cost || msg.onInitSubmission?.cost || '0.00';\nlet tasksCount = msg.final_tasks_count || msg.onInitSubmission?.tasks_count || 0;\nlet outputDir = msg.final_output_dir || msg.onInitSubmission?.output_dir || 'Procesando...';\nlet inventory = msg.inventory || msg.onInitSubmission?.inventory || '';\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCDD CONSTRUIR RESUMEN FORMATEADO\n// ═══════════════════════════════════════════════════════════════\n\n// URL de descarga\nconst downloadUrl = `http://localhost:8000/api/v1/download/${jobId}`;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ GUARDAR DIRECTAMENTE EN msg (SIN NESTING)\n// ═══════════════════════════════════════════════════════════════\n\nmsg.project_name = projectName;\nmsg.job_id = jobId;\nmsg.total_tokens = String(totalTokens);\nmsg.cost = String(cost);\nmsg.tasks_count = String(tasksCount);\nmsg.output_dir = outputDir;\nmsg.inventory = inventory;\nmsg.download_url = downloadUrl;\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ TAMBIÉN EN msg.onInitSubmission (para formio)\n// ═══════════════════════════════════════════════════════════════\n\nmsg.onInitSubmission = {\n    project_name: projectName,\n    job_id: jobId,\n    total_tokens: String(totalTokens),\n    cost: String(cost),\n    tasks_count: String(tasksCount),\n    output_dir: outputDir,\n    inventory: inventory,\n    download_url: downloadUrl\n};\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCB LOGGING DETALLADO\n// ═══════════════════════════════════════════════════════════════\n\nnode.warn('═════════════════════════════════════════════════════');\nnode.warn('✅ DATOS PREPARADOS PARA FORMULARIO');\nnode.warn('═════════════════════════════════════════════════════');\nnode.warn(`\uD83C\uDFE2 Proyecto: ${projectName}`);\nnode.warn(`\uD83D\uDCCC Job ID: ${jobId}`);\nnode.warn(`\uD83D\uDCCA Tokens: ${totalTokens}`);\nnode.warn(`\uD83D\uDCB0 Costo: $${cost}`);\nnode.warn(`\uD83D\uDCCB Tareas: ${tasksCount}`);\nnode.warn(`\uD83D\uDCC1 Salida: ${outputDir}`);\nnode.warn(`\uD83D\uDCE5 Descarga: ${downloadUrl}`);\nnode.warn('═════════════════════════════════════════════════════');\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `✅ ${tasksCount} tareas - $${cost}`\n});\n\n// ⭐ RETORNAR msg\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":580,"y":400,"wires":[["6d54d8b0.9f4448","80715f0f.df2258"]]},{"id":"f3e8da2.a7fc028","type":"delay","z":"ef48fe5e.6a89","name":"","pauseType":"delay","timeout":"1","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"x":340,"y":400,"wires":[["30ad814b.28d00e"]]},{"id":"8016a97f.8b5e1","type":"delay","z":"ef48fe5e.6a89","name":"","pauseType":"delay","timeout":"2","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"x":360,"y":200,"wires":[["764d0bf3.548424"]]},{"id":"764d0bf3.548424","type":"function","z":"ef48fe5e.6a89","name":"preparar descarga","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Preparar datos resultado final - ANTES DE DESCARGA\"\n// ═══════════════════════════════════════════════════════════════\n\nconst jobId = msg.job_id || msg.submission?.job_id || msg.onInitSubmission?.job_id;\n\nif (!jobId) {\n    node.warn('⚠️ No hay job_id');\n    return msg;\n}\n\nnode.warn(`\uD83D\uDCE5 Preparando datos finales para job: ${jobId}`);\n\n// Leer desde msg.payload (respuesta GET /jobs/)\nconst payload = msg.payload || {};\n\n// ⭐ EXTRAER LOS DATOS CORRECTAMENTE\nconst tasksCount = payload.result?.tasks_count || 0;\nconst totalTokens = payload.result?.token_usage?.total_tokens || 0;\nconst cost = payload.result?.token_usage?.cost || 0;\nconst outputDir = payload.result?.output_dir || payload.result?.files_generated?.[0]?.split('/')[0] || 'N/A';\nconst userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\nconst projectName = global.get(`project_name_${userId}`)\nnode.warn(`   Total Tokens: ${totalTokens}`);\nnode.warn(`   Costo: $${cost}`);\nnode.warn(`   Tareas: ${tasksCount}`);\nnode.warn(`   Directorio: ${outputDir}`);\n\n// ⭐ GUARDAR EN msg (para que el siguiente nodo lo lea)\nmsg.final_total_tokens = totalTokens;\nmsg.final_cost = cost;\nmsg.final_tasks_count = tasksCount;\nmsg.final_output_dir = outputDir;\nmsg.project_name = projectName;\nmsg.job_id = jobId;\n\n// También en onInitSubmission por si hay redirect\nif (!msg.onInitSubmission) msg.onInitSubmission = {};\nmsg.onInitSubmission.final_total_tokens = totalTokens;\nmsg.onInitSubmission.final_cost = cost;\nmsg.onInitSubmission.final_tasks_count = tasksCount;\nmsg.onInitSubmission.final_output_dir = outputDir;\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":570,"y":260,"wires":[["7a87f8aa.1edca"]]},{"id":"431f856b.459a24","type":"axetflows-view-action","z":"ef48fe5e.6a89","name":"","action":"update","redirectPage":null,"downloadFile":false,"fileName":"Modificaciones.zip","inputType":"buffer","message":"","messageType":"info","x":1310,"y":120,"wires":[]},{"id":"6d54d8b0.9f4448","type":"debug","z":"ef48fe5e.6a89","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":810,"y":420,"wires":[]},{"id":"7a87f8aa.1edca","type":"function","z":"ef48fe5e.6a89","name":"Interceptar descarga - Obtener ZIP","func":"const axios = require('axios');\n\nconst jobId = msg.job_id || \n              msg.submission?.job_id || \n              msg.onInitSubmission?.job_id;\n\nif (!jobId) {\n    node.error('❌ No hay job_id para descargar ZIP');\n    return null;\n}\n\nnode.warn(`\uD83D\uDCE5 DESCARGANDO ZIP para job: ${jobId.substring(0, 8)}...`);\n\nconst url = `http://localhost:8000/api/v1/download/${jobId}`;\n\naxios.get(url, {\n    responseType: 'arraybuffer',\n    timeout: 120000\n})\n    .then(response => {\n        const data = Buffer.from(response.data);\n        const userId = msg.__axetFlowsSecurityContext?.login ||\n            msg.__axetFlowsSecurityContext?.login ||\n            msg.req?.user?.id ||\n            \"default_user\";\n        const projectName = msg.submission?.projectPath;\n        const fileName = projectName + \".zip\" || `MiProyecto_${jobId.substring(0, 8)}.zip`;\n        \n        node.warn(`✅ ZIP recibido: ${data.length} bytes`);\n        \n        // ⭐ GUARDAR EL BUFFER EN msg.payload\n        msg.payload = data;\n        msg.fileName = fileName;\n        msg.size = data.length;\n        \n        // Configurar para download\n        msg.downloadFileSubmission = {\n            data: data,\n            fileName: fileName,\n            inputType: 'buffer'\n        };\n        \n        node.status({ fill: 'green', shape: 'dot', text: 'ZIP descargado' });\n        node.warn(`\uD83D\uDCE6 ZIP listo: ${fileName}`);\n        \n        // ⭐ ENVIAR desde callback\n        node.send(msg);\n    })\n    .catch(error => {\n        node.error('❌ Error: ' + error.message);\n        node.status({ fill: 'red', shape: 'ring', text: 'Error descarga' });\n        // Igualmente enviar para que muestre error\n        node.send(msg);\n    });\n\nreturn null;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":840,"y":260,"wires":[["d033d18f.f1c0f"]]},{"id":"d033d18f.f1c0f","type":"function","z":"ef48fe5e.6a89","name":"Validar ZIP y preparar descarga","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Validar ZIP y preparar descarga - VERSIÓN BUFFER\"\n// ═══════════════════════════════════════════════════════════════\n\nconst jobId = msg.job_id || msg.submission?.job_id || 'unknown';\nconst projectName = msg.project_name || msg.submission?.project_name || 'MiProyecto';\n\n// ✅ VALIDAR QUE EL ZIP ESTÁ EN msg.payload\nif (!msg.payload || !Buffer.isBuffer(msg.payload)) {\n    node.error('❌ No hay archivo ZIP en msg.payload');\n    return null;\n}\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCE6 PREPARAR downloadFileSubmission CON BUFFER\n// ═══════════════════════════════════════════════════════════════\n\nconst fileName = msg.fileName || `${projectName}_${jobId.substring(0, 8)}.zip`;\n\nmsg.downloadFileSubmission = {\n    data: msg.payload,           // ⭐ BUFFER directo\n    fileName: fileName,\n    inputType: 'buffer'          // ⭐ tipo buffer\n};\n\n// ═══════════════════════════════════════════════════════════════\n// ⭐ ASEGURAR submission\n// ═══════════════════════════════════════════════════════════════\n\nif (!msg.submission) {\n    msg.submission = {};\n}\n\nmsg.submission.downloadFileSubmission = msg.downloadFileSubmission;\nmsg.submission.fileName = fileName;\nmsg.submission.job_id = jobId;\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCCB LOGGING\n// ═══════════════════════════════════════════════════════════════\n\nnode.warn('═══════════════════════════════════════');\nnode.warn('✅ ZIP PREPARADO PARA DESCARGA');\nnode.warn(`   Buffer: ${msg.payload.length} bytes`);\nnode.warn(`   Nombre: ${fileName}`);\nnode.warn(`   Tipo: buffer`);\nnode.warn(`   msg.submission.downloadFileSubmission: ✓`);\nnode.warn('═══════════════════════════════════════');\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `Listo: ${fileName}`\n});\n\n// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Limpiar carpetas - VERSIÓN PER-USER\"\n// ═══════════════════════════════════════════════════════════════\n\nconst fs = require('fs').promises;\nconst path = require('path');\n\nasync function limpiar() {\n    // ⭐ OBTENER userId\n    const userId = msg.__axetFlowsSecurityContext?.login ||\n        msg.req?.user?.id ||\n        \"default_user\";\n\n    node.warn(`\uD83D\uDC64 Limpiando para usuario: ${userId}`);\n\n    // ⭐ RECUPERAR IDs desde global.set()\n    const uploadId = global.get(`upload_id_${userId}`);\n    const jobId = msg.submission.job_id;\n\n    if (!uploadId && !jobId) {\n        node.warn('⚠️ No hay upload_id ni job_id para limpiar');\n        return;\n    }\n\n    node.warn('═══════════════════════════════════════════════════════════════');\n    node.warn('\uD83D\uDDD1️  INICIANDO LIMPIEZA DE CARPETAS');\n    node.warn('═══════════════════════════════════════════════════════════════');\n\n    // \uD83D\uDCC1 LIMPIAR UPLOAD\n    if (uploadId) {\n        try {\n            const uploadDir = path.join('/internal-storage-files/files', 'uploads', uploadId);\n            await fs.rm(uploadDir, { recursive: true, force: true });\n            node.warn(`✅ Carpeta de upload ELIMINADA: ${uploadDir}`);\n\n            // Limpiar también de global\n            global.set(`upload_id_${userId}`, null);\n        } catch (error) {\n            node.error(`❌ Error eliminando upload: ${error.message}`);\n        }\n    }\n\n    // \uD83D\uDCC1 LIMPIAR DOWNLOAD (outputs)\n    if (jobId) {\n        try {\n            // \uD83D\uDCC1 Eliminar carpeta completa de outputs\n            const outputDir = path.join('/internal-storage-files/files', 'outputs', jobId);\n            await fs.rm(outputDir, { recursive: true, force: true });\n            node.warn(`✅ Carpeta de output ELIMINADA: ${outputDir}`);\n\n            // \uD83D\uDCE6 Eliminar archivo ZIP asociado (por si está en otro lugar)\n            const zipFile = path.join('/internal-storage-files/files', 'outputs', `${jobId}.zip`);\n            try {\n                await fs.unlink(zipFile);\n                node.warn(`✅ Archivo ZIP ELIMINADO: ${zipFile}`);\n            } catch {\n                // Si no existe, no hay problema\n                node.warn(`⚠️ Archivo ZIP no encontrado: ${zipFile}`);\n            }\n\n        } catch (error) {\n            node.error(`❌ Error eliminando output: ${error.message}`);\n        }\n    }\n\n\n    node.warn('═══════════════════════════════════════════════════════════════');\n    node.warn('✅ LIMPIEZA COMPLETADA');\n    node.warn('═══════════════════════════════════════════════════════════════');\n\n    node.status({ fill: 'green', shape: 'dot', text: 'Limpieza OK' });\n}\n\n// Ejecutar limpieza\nlimpiar().catch(err => node.error(err));\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":1150,"y":260,"wires":[["8d73dc50.01cc28","6b07d26d.24da84"]]},{"id":"8d73dc50.01cc28","type":"axetflows-view-action","z":"ef48fe5e.6a89","name":"Descargar ZIP","action":"update","redirectPage":null,"downloadFile":true,"fileName":"","inputType":"buffer","message":"✅ Descargando archivo...","messageType":"info","x":1420,"y":220,"wires":[]},{"id":"6b07d26d.24da84","type":"debug","z":"ef48fe5e.6a89","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":1390,"y":300,"wires":[]},{"id":"aa8d169a.484a18","type":"axetflows-form","z":"ef48fe5e.6a89","name":"Resultado Final HITL","onDocumentReadyButtonAction":"","formStructure":{"display":"form","components":[{"label":"HTML","tag":"style","className":"","attrs":[{"attr":"","value":""}],"content":"/* ─────────────────────────────────────────────────────────────────────────────\r\n\t PALETA Y RESET\r\n───────────────────────────────────────────────────────────────────────────── */\r\n*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\r\n:root{\r\n\t--bg: #0b1220;\r\n\t--bg-alt: #131d30;\r\n\t--panel: #1e2a3d;\r\n\t--panel-soft: #25364b;\r\n\t--border: #2f455e;\r\n\t--border-soft:#1d2a3b;\r\n\t--accent: #6366f1;\r\n\t--accent-hover:#5255e9;\r\n\t--accent-gradient: linear-gradient(135deg,#6366f1 0%,#818cf8 55%,#a5b4fc 100%);\r\n\t--danger:#dc2626;\r\n\t--success:#16a34a;\r\n\t--warning:#f59e0b;\r\n\t--text:#f1f5f9;\r\n\t--text-dim:#94a3b8;\r\n\t--radius:14px;\r\n\t--shadow:0 4px 18px -4px rgba(0,0,0,.4),0 2px 6px -2px rgba(0,0,0,.35);\r\n\t--trans:0.18s cubic-bezier(.4,.2,.2,1);\r\n}\r\nbody{background:radial-gradient(circle at 25% 15%,#142235,#0b1220 55%) fixed;color:var(--text);line-height:1.5;min-height:100vh;}\r\nheader,footer{padding:1.15rem 1.75rem;background:rgba(30,42,61,.85);backdrop-filter:blur(6px);border-bottom:1px solid var(--border-soft)}\r\nheader h1{margin:0;font-size:1.35rem;font-weight:600;letter-spacing:.5px;background:var(--accent-gradient);-webkit-background-clip:text;background-clip:text;color:transparent}\r\nmain{max-width:1220px;margin:1.25rem auto;padding:0 1.25rem;display:grid;gap:1.25rem}\r\n\r\n/* ─────────────────────────────────────────────────────────────────────────────\r\n\t COMPONENTES\r\n───────────────────────────────────────────────────────────────────────────── */\r\n.card{background:linear-gradient(145deg,#1d2838,#233146 60%,#1b2738);padding:1.1rem 1.3rem;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow);position:relative;overflow:hidden}\r\n.card:before{content:\"\";position:absolute;inset:0;background:radial-gradient(circle at 85% 15%,rgba(255,255,255,.06),transparent 55%);opacity:.7;pointer-events:none}\r\n.card h2{margin:0 0 .65rem;font-size:1.05rem;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--text-dim)}\r\n\r\nform{display:grid;gap:.9rem}\r\nlabel{display:grid;gap:.4rem;font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim)}\r\ninput,select{width:100%;padding:.7rem .8rem;border:1px solid var(--border);border-radius:10px;background:#0f1929;color:var(--text);font-size:.85rem;transition:var(--trans);}\r\ninput:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(99,102,241,.25)}\r\ndetails{border:1px solid var(--border);border-radius:10px;padding:.5rem .75rem;background:#192536}\r\ndetails[open]{background:#1d2d42}\r\ndetails summary{cursor:pointer;font-size:.75rem;font-weight:600;color:var(--accent);}\r\n\r\nbutton{cursor:pointer;font-weight:600;padding:.7rem 1rem;border-radius:10px;border:1px solid var(--border);background:var(--panel-soft);color:var(--text);font-size:.75rem;letter-spacing:.05em;transition:var(--trans);position:relative;overflow:hidden}\r\nbutton:hover{background:#314766}\r\nbutton#startBtn{background:var(--accent-gradient);border:none;color:#fff;box-shadow:0 4px 14px -4px rgba(99,102,241,.55)}\r\nbutton#startBtn:hover{filter:brightness(1.05)}\r\nbutton:disabled{opacity:.55;cursor:not-allowed}\r\n\r\n.status{margin-top:.4rem;font-size:.7rem;min-height:1.1rem;font-weight:500;letter-spacing:.04em;color:var(--text-dim)}\r\n.status.error{color:var(--danger)}\r\n.status.info{color:var(--accent)}\r\n.status.success{color:var(--success)}\r\n\r\n.hidden{display:none}\r\n\r\n/* ─────────────────────────────────────────────────────────────────────────────\r\n\t ACCORDION STYLES\r\n───────────────────────────────────────────────────────────────────────────── */\r\n#insights-accordion, #recommendations-accordion {\r\n\tcursor: pointer;\r\n\tdisplay: flex;\r\n\tjustify-content: space-between;\r\n\talign-items: center;\r\n\tuser-select: none;\r\n\ttransition: var(--trans);\r\n}\r\n\r\n#insights-accordion:hover, #recommendations-accordion:hover {\r\n\tbackground: rgba(99, 102, 241, 0.1);\r\n\tborder-color: var(--accent);\r\n}\r\n\r\n#insights-toggle, #recommendations-toggle {\r\n\tfont-size: 1.1rem;\r\n\ttransition: transform 0.3s cubic-bezier(0.4, 0.2, 0.2, 1);\r\n\tdisplay: inline-block;\r\n}\r\n\r\n#insights-section, #recommendations-section {\r\n\ttransition: all 0.3s cubic-bezier(0.4, 0.2, 0.2, 1);\r\n\tmax-height: 2000px;\r\n\toverflow: hidden;\r\n\topacity: 1;\r\n}\r\n\r\n#insights-section.hidden, #recommendations-section.hidden {\r\n\tmax-height: 0;\r\n\topacity: 0;\r\n\tpadding: 0 !important;\r\n\tmargin: 0 !important;\r\n\tborder: none !important;\r\n}\r\n\r\ntable{width:100%;border-collapse:separate;border-spacing:0;font-size:.75rem;overflow:hidden;border:1px solid var(--border);border-radius:12px;background:var(--panel-soft)}\r\nthead th{padding:.6rem .7rem;text-align:left;background:#2a3c52;color:var(--text-dim);font-weight:700;font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;border-bottom:1px solid var(--border)}\r\ntbody td{padding:.55rem .7rem;border-bottom:1px solid #28394e}\r\ntbody tr:last-child td{border-bottom:none}\r\ntbody tr{transition:var(--trans)}\r\ntbody tr:hover{background:#2b4159}\r\ntbody tr:active{filter:brightness(1.08)}\r\n\r\n.badge{display:inline-flex;align-items:center;gap:.25rem;padding:.28rem .6rem;border-radius:40px;font-size:.58rem;font-weight:600;letter-spacing:.04em;background:#33465c;color:#fff;box-shadow:0 2px 4px -1px #0006}\r\n.badge.inactiva{background:var(--danger)}\r\n.badge.activa{background:var(--success)}\r\n.badge.latente{background:var(--warning);color:#1e1e1e}\r\n.badge.api-type{background:linear-gradient(135deg,#6366f1,#818cf8);color:#fff;font-weight:700}\r\n.badge.method-get{background:#10b981;color:#fff}\r\n.badge.method-post{background:#f59e0b;color:#1e1e1e}\r\n.badge.method-put{background:#3b82f6;color:#fff}\r\n.badge.method-delete{background:#ef4444;color:#fff}\r\n.badge.method-patch{background:#8b5cf6;color:#fff}\r\n\r\n.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-top:.9rem}\r\n.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-top:.9rem}\r\n.metric{padding:.65rem .75rem;background:#102035;border:1px solid var(--border);border-radius:12px;text-align:center;position:relative;isolation:isolate;overflow:hidden}\r\n.metric:before{content:\"\";position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.05),transparent 60%);opacity:.8;pointer-events:none}\r\n.metric h3{margin:.25rem 0;font-size:.62rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim)}\r\n.metric p{margin:0;font-size:1.15rem;font-weight:700;color:#fff;text-shadow:0 1px 2px #000}\r\n.metric-label{font-size:.65rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dim);margin-bottom:.3rem}\r\n.metric-value{font-size:1.75rem;font-weight:700;color:var(--accent)}\r\n\r\n#dashboard-actions button{flex:1 1 auto;min-width:130px}\r\n#dashboard-actions{background:linear-gradient(120deg,#1d2838,#243448);border:1px solid var(--border);}\r\nfooter{text-align:center;font-size:.65rem;color:var(--text-dim);margin:2.5rem 0 1rem}\r\n\r\n/* Scrollbar sutil */\r\n::-webkit-scrollbar{width:10px;height:10px}\r\n::-webkit-scrollbar-track{background:#0b1220}\r\n::-webkit-scrollbar-thumb{background:#1f2f44;border-radius:6px;border:2px solid #0b1220}\r\n::-webkit-scrollbar-thumb:hover{background:#29425e}\r\n\r\n/* Pequeña animación de aparición */\r\n.card, .metric, table, button{animation:fadeIn .5s ease}\r\n@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}\r\n\r\n/* Responsive ajustes */\r\n@media (max-width:740px){\r\n\tmain{gap:1rem}\r\n\theader h1{font-size:1.15rem}\r\n\t.summary-grid{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}\r\n\t#dashboard-actions button{min-width:100px;padding:.55rem .6rem;font-size:.63rem}\r\n\tbutton{font-size:.7rem}\r\n}","refreshOnChange":false,"customClass":"","hidden":false,"tableView":false,"modalEdit":false,"key":"html1","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"htmlelement","input":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"e16tho"},{"label":"HTML","tag":"p","className":"","attrs":[{"attr":"","value":""}],"content":"<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <title>Application Inventory Agent</title>\r\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\r\n  <link rel=\"stylesheet\" href=\"style.css\" />\r\n</head>\r\n<body>\r\n  <header>\r\n    <h1>� Application Inventory Agent - Dashboard</h1>\r\n  </header>\r\n\r\n  <main id=\"app\">\r\n    <section id=\"loading\" class=\"card\" style=\"text-align:center;padding:2rem\">\r\n      <p style=\"font-size:1rem;margin:1rem 0\">Cargando análisis…</p>\r\n      <div style=\"width:100%;height:4px;background:#2a3d54;border-radius:20px;overflow:hidden\">\r\n        <div id=\"progressBar\" style=\"height:100%;width:0%;background:linear-gradient(90deg,#6366f1,#818cf8);animation:progress 1.5s ease-in-out infinite\"></div>\r\n      </div>\r\n      <div id=\"status\" class=\"status\"></div>\r\n    </section>\r\n    <section id=\"dashboard\" class=\"hidden\">\r\n      <div class=\"card\" id=\"dashboard-actions\" style=\"display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;justify-content:space-between\">\r\n        <div style=\"display:flex;gap:.5rem;flex-wrap:wrap\">\r\n          <button type=\"button\" id=\"backBtn\" style=\"background:#334155\">← Volver</button>\r\n          <button type=\"button\" id=\"reloadBtn\" style=\"background:#334155\">\uD83D\uDD04 Recargar</button>\r\n          <button type=\"button\" id=\"downloadJsonZipBtn\" style=\"background:#6366f1\">\uD83D\uDCE5 Descargar Catálogo</button>\r\n        </div>\r\n        <div id=\"dashboardPlatform\" style=\"font-size:.7rem;color:#94a3b8\"></div>\r\n      </div>\r\n\r\n      <!-- RESUMEN EJECUTIVO -->\r\n      <div class=\"card\" id=\"summary\"></div>\r\n\r\n      <!-- INVENTARIO DE APLICACIONES -->\r\n      <div class=\"card\" id=\"applications-section\">\r\n        <h2>\uD83D\uDCE6 Catálogo de Aplicaciones</h2>\r\n        <p style=\"color:#94a3b8;font-size:0.85rem;margin-bottom:1.5rem;\">Lista consolidada de todas las aplicaciones y servicios identificados</p>\r\n        <div id=\"applications-container\" style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem;\">\r\n          <!-- Poblado dinámicamente -->\r\n        </div>\r\n      </div>\r\n\r\n      <!-- REPOSITORIOS -->\r\n      <div class=\"card\" id=\"repositories-section\">\r\n        <h2>\uD83D\uDDC2️ Repositorios Analizados</h2>\r\n        <p style=\"color:#94a3b8;font-size:0.85rem;margin-bottom:1.5rem;\">Información de repositorios, tags y configuración</p>\r\n        <table id=\"repositories-table\" style=\"width:100%;border-collapse:collapse;\">\r\n          <thead>\r\n            <tr style=\"border-bottom:1px solid #334155;\">\r\n              <th style=\"text-align:left;padding:0.5rem;color:#94a3b8;\">Repositorio</th>\r\n              <th style=\"text-align:left;padding:0.5rem;color:#94a3b8;\">Tags</th>\r\n              <th style=\"text-align:left;padding:0.5rem;color:#94a3b8;\">Últim. Actualización</th>\r\n              <th style=\"text-align:left;padding:0.5rem;color:#94a3b8;\">Dueño</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody id=\"repositories-tbody\">\r\n            <!-- Poblado dinámicamente -->\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n\r\n      <!-- PROBLEMAS Y ANOMALÍAS DETECTADAS -->\r\n      <div class=\"card\" id=\"issues-section\">\r\n        <h2>⚠️ Problemas Detectados</h2>\r\n        <p style=\"color:#94a3b8;font-size:0.85rem;margin-bottom:1.5rem;\">Inconsistencias, duplicados y aplicaciones huérfanas</p>\r\n        <div id=\"issues-container\" style=\"display:flex;flex-direction:column;gap:0.5rem;\">\r\n          <!-- Poblado dinámicamente -->\r\n        </div>\r\n      </div>\r\n\r\n      <!-- ANÁLISIS CON IA -->\r\n      <div class=\"card\" id=\"llm-analysis-section\">\r\n        <h2>\uD83E\uDD16 Análisis Inteligente del Inventario</h2>\r\n        <p style=\"color:#94a3b8;font-size:0.85rem;margin-bottom:1.5rem;\">Insights y recomendaciones generadas por IA</p>\r\n        \r\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;\" id=\"llm-button-section\">\r\n          <!-- 1. Salud del Inventario -->\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n            <h3 style=\"color:#6366f1;font-size:0.9rem;margin-bottom:0.5rem;\">� Salud del Inventario</h3>\r\n            <p style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:1rem;line-height:1.4;\">Evalúa cobertura y completitud.</p>\r\n            <button type=\"button\" class=\"analyze-btn\" data-analysis=\"health\" style=\"background:#6366f1;width:100%;color:white;border:none;padding:0.5rem;border-radius:4px;cursor:pointer;\">Analizar</button>\r\n          </div>\r\n\r\n          <!-- 2. Duplicados y Consolidación -->\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n            <h3 style=\"color:#ef4444;font-size:0.9rem;margin-bottom:0.5rem;\">� Duplicados</h3>\r\n            <p style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:1rem;line-height:1.4;\">Detecta apps duplicadas.</p>\r\n            <button type=\"button\" class=\"analyze-btn\" data-analysis=\"duplicates\" style=\"background:#ef4444;width:100%;color:white;border:none;padding:0.5rem;border-radius:4px;cursor:pointer;\">Detectar</button>\r\n          </div>\r\n\r\n          <!-- 3. Aplicaciones Huérfanas -->\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n            <h3 style=\"color:#f59e0b;font-size:0.9rem;margin-bottom:0.5rem;\">\uD83D\uDC64 Huérfanas</h3>\r\n            <p style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:1rem;line-height:1.4;\">Sin propietario asignado.</p>\r\n            <button type=\"button\" class=\"analyze-btn\" data-analysis=\"orphans\" style=\"background:#f59e0b;width:100%;color:white;border:none;padding:0.5rem;border-radius:4px;cursor:pointer;\">Revisar</button>\r\n          </div>\r\n\r\n          <!-- 4. Análisis de Dependencias -->\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n            <h3 style=\"color:#8b5cf6;font-size:0.9rem;margin-bottom:0.5rem;\">� Dependencias</h3>\r\n            <p style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:1rem;line-height:1.4;\">Mapeo de relaciones.</p>\r\n            <button type=\"button\" class=\"analyze-btn\" data-analysis=\"dependencies\" style=\"background:#8b5cf6;width:100%;color:white;border:none;padding:0.5rem;border-radius:4px;cursor:pointer;\">Mapear</button>\r\n          </div>\r\n\r\n          <!-- 5. Recomendaciones -->\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n            <h3 style=\"color:#10b981;font-size:0.9rem;margin-bottom:0.5rem;\">� Recomendaciones</h3>\r\n            <p style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:1rem;line-height:1.4;\">Acciones y mejoras sugeridas.</p>\r\n            <button type=\"button\" class=\"analyze-btn\" data-analysis=\"recommendations\" style=\"background:#10b981;width:100%;color:white;border:none;padding:0.5rem;border-radius:4px;cursor:pointer;\">Consultar</button>\r\n          </div>\r\n\r\n          <!-- 6. Plan de Consolidación -->\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n            <h3 style=\"color:#06b6d4;font-size:0.9rem;margin-bottom:0.5rem;\">� Consolidación</h3>\r\n            <p style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:1rem;line-height:1.4;\">Plan de consolidación.</p>\r\n            <button type=\"button\" class=\"analyze-btn\" data-analysis=\"consolidation\" style=\"background:#06b6d4;width:100%;color:white;border:none;padding:0.5rem;border-radius:4px;cursor:pointer;\">Generar</button>\r\n          </div>\r\n        </div>\r\n        \r\n        <div id=\"loading-container\" style=\"margin-top:2rem;display:none;\">\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1.5rem;\">\r\n            <h3 id=\"llm-loading-title\" style=\"color:#6366f1;margin-bottom:1rem;\"></h3>\r\n            <div id=\"llm-loading-content\" style=\"color:#cbd5e1;line-height:1.6;white-space:pre-wrap;font-size:0.9rem;max-height:600px;overflow-y:auto;\"></div>\r\n          </div>\r\n        </div>\r\n\r\n        <div id=\"llm-results-container\" style=\"margin-top:2rem;display:none;\">\r\n          <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1.5rem;\">\r\n            <h3 id=\"llm-results-title\" style=\"color:#6366f1;margin-bottom:1rem;\"></h3>\r\n            <div id=\"llm-results-content\" style=\"color:#cbd5e1;line-height:1.6;white-space:pre-wrap;font-size:0.9rem;max-height:600px;overflow-y:auto;\"></div>\r\n            <button type=\"button\" id=\"closeLlmResultsBtn\" style=\"margin-top:1rem;background:#334155;color:white;border:none;padding:0.5rem 1rem;border-radius:4px;cursor:pointer;\">Cerrar</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <script src=\"example.js\"></script>\r\n</body>\r\n</html>","refreshOnChange":true,"customClass":"","hidden":false,"tableView":false,"modalEdit":false,"key":"html","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"htmlelement","input":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"ekqmtip"},{"content":"$(document).ready(async function () {\r\n  $('.formio-component-button').hide();\r\n  $('.alerts-status-bar').hide();\r\n  const statusEl = document.getElementById('status');\r\n  const loadingEl = document.getElementById('loading');\r\n  const dashboardEl = document.getElementById('dashboard');\r\n  const backBtn = document.getElementById('backBtn');\r\n  const reloadBtn = document.getElementById('reloadBtn');\r\n  const downloadBtn = document.getElementById('downloadJsonZipBtn');\r\n  const summaryEl = document.getElementById('summary');\r\n  const analyzeBtn = document.getElementById('analyze-btn');\r\n  const resultsContainer = document.getElementById('llm-results-container');\r\n  const loadingContainer = document.getElementById('loading-container');\r\n  const loadingTitle = document.getElementById('llm-loading-title');\r\n  const loadingContent = document.getElementById('llm-loading-content');\r\n  const resultTitle = document.getElementById('llm-results-title');\r\n  const resultContent = document.getElementById('llm-results-content');\r\n  const llmButtonsContent = document.getElementById('llm-button-section');\r\n  const closeLlmResultsBtn = document.getElementById('closeLlmResultsBtn');\r\n  \r\n  let currentJobId = null;\r\n  \r\n  const log = function(msg, type = 'info') {\r\n    const prefix = {\r\n      'info': '\uD83D\uDCCB',\r\n      'success': '✅',\r\n      'error': '❌',\r\n      'warn': '⚠️',\r\n      'loading': '⏳'\r\n    }[type] || '•';\r\n    \r\n    console.log(`${prefix} ${msg}`);\r\n  }\r\n  \r\n  const showStatus = function(msg, type = 'info') {\r\n    const statusEl = document.getElementById('status');\r\n    if (!statusEl) return;\r\n    \r\n    const icons = {\r\n      'info': '\uD83D\uDCCB',\r\n      'success': '✅',\r\n      'error': '❌',\r\n      'warn': '⚠️',\r\n      'loading': '⏳'\r\n    };\r\n    \r\n    statusEl.innerHTML = `<p class=\"${type}\">${icons[type]} ${msg}</p>`;\r\n    statusEl.style.display = 'block';\r\n  }\r\n  \r\n  const clearStatus = function() {\r\n    const statusEl = document.getElementById('status');\r\n    if (statusEl) {\r\n      statusEl.innerHTML = '';\r\n      statusEl.style.display = 'none';\r\n    }\r\n  }\r\n  \r\n  const setStatus = function(msg, type='info'){\r\n    statusEl.textContent = msg;\r\n    statusEl.className = 'status ' + type;\r\n  }\r\n  \r\n  const renderDashboard = function(){\r\n    const inventoryData = data.inventory;\r\n    const summary = inventoryData.summary || {};\r\n    const applications = inventoryData.applications || [];\r\n    const repositories = inventoryData.repositories || [];\r\n    const issues = inventoryData.issues_detected || [];\r\n    \r\n    // ===== RESUMEN EJECUTIVO =====\r\n    if (summaryEl) {\r\n      const metrics = [\r\n        { label: 'Aplicaciones', value: applications.length, emoji: '\uD83D\uDCE6' },\r\n        { label: 'Repositorios', value: repositories.length, emoji: '\uD83D\uDDC2️' },\r\n        { label: 'Problemas', value: issues.length, emoji: '⚠️' },\r\n        { label: 'Índice Salud', value: summary.health_score ? summary.health_score + '%' : 'N/A', emoji: '\uD83D\uDC8A' },\r\n      ];\r\n      \r\n      summaryEl.innerHTML = `\r\n        <h2>\uD83D\uDCCA Resumen del Inventario</h2>\r\n        <div class=\"metrics-grid\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin-top:1rem;\">\r\n          ${metrics.map(m => `\r\n            <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;text-align:center;\">\r\n              <div style=\"font-size:2rem;margin-bottom:0.5rem;\">${m.emoji}</div>\r\n              <div style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:0.5rem;\">${m.label}</div>\r\n              <div style=\"color:#6366f1;font-size:1.5rem;font-weight:bold;\">${m.value}</div>\r\n            </div>\r\n          `).join('')}\r\n        </div>\r\n        ${summary.executive_summary ? `\r\n          <div style=\"margin-top:1.5rem;padding:1rem;background:#0f172a;border-left:4px solid #6366f1;border-radius:4px;\">\r\n            <p style=\"color:#cbd5e1;line-height:1.6;\">${summary.executive_summary}</p>\r\n          </div>\r\n        ` : ''}\r\n      `;\r\n    }\r\n  \r\n  \r\n    // ===== CATÁLOGO DE APLICACIONES =====\r\n    const appsContainer = document.getElementById('applications-container');\r\n    if (appsContainer && applications.length > 0) {\r\n      appsContainer.innerHTML = applications.map(app => `\r\n        <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n          <h3 style=\"color:#6366f1;margin-bottom:0.5rem;\">${app.name || 'Sin nombre'}</h3>\r\n          <div style=\"color:#94a3b8;font-size:0.85rem;line-height:1.6;\">\r\n            <p><strong>Dueño:</strong> ${app.owner || 'No asignado'}</p>\r\n            <p><strong>Estado:</strong> <span style=\"color:${app.status === 'Active' ? '#10b981' : '#f59e0b'}\">${app.status || 'Desconocido'}</span></p>\r\n            <p><strong>Repositorios:</strong> ${(app.repositories || []).length}</p>\r\n            ${app.version ? `<p><strong>Versión:</strong> ${app.version}</p>` : ''}\r\n            ${app.description ? `<p><strong>Descripción:</strong> ${app.description}</p>` : ''}\r\n          </div>\r\n        </div>\r\n      `).join('');\r\n    }\r\n    \r\n    // ===== TABLA DE REPOSITORIOS =====\r\n    const tbody = document.getElementById('repositories-tbody');\r\n    if (tbody && repositories.length > 0) {\r\n      tbody.innerHTML = repositories.map(repo => `\r\n        <tr style=\"border-bottom:1px solid #334155;\">\r\n          <td style=\"padding:0.5rem;\"><strong>${repo.name || 'N/A'}</strong></td>\r\n          <td style=\"padding:0.5rem;\">${repo.tags ? repo.tags.length : 0}</td>\r\n          <td style=\"padding:0.5rem;font-size:0.85rem;\">${repo.last_commit ? formatDate(repo.last_commit) : 'N/A'}</td>\r\n          <td style=\"padding:0.5rem;\">${repo.owner || 'N/A'}</td>\r\n        </tr>\r\n      `).join('');\r\n    }\r\n  \r\n    // ===== PROBLEMAS DETECTADOS =====\r\n    const issuesContainer = document.getElementById('issues-container');\r\n    if (issuesContainer && issues.length > 0) {\r\n      issuesContainer.innerHTML = issues.map(issue => {\r\n        const colorMap = {\r\n          'critical': '#ef4444',\r\n          'high': '#f59e0b',\r\n          'medium': '#eab308',\r\n          'low': '#10b981'\r\n        };\r\n        const color = colorMap[issue.severity] || '#94a3b8';\r\n        return `\r\n          <div style=\"background:#0f172a;border-left:4px solid ${color};border-radius:4px;padding:1rem;color:#cbd5e1;\">\r\n            <strong style=\"color:${color};text-transform:uppercase;font-size:0.85rem;\">${issue.severity || 'INFO'}</strong>\r\n            <p style=\"margin-top:0.5rem;margin-bottom:0;\">${issue.message || 'Problema detectado'}</p>\r\n            ${issue.details ? `<p style=\"margin-top:0.5rem;color:#94a3b8;font-size:0.85rem;\">${issue.details}</p>` : ''}\r\n          </div>\r\n        `;\r\n      }).join('');\r\n    }\r\n  }\r\n  \r\n  const iniciarCargaAnalisis = function(title){\r\n    loadingContainer.classList.remove('hidden');\r\n    llmButtonsContent.classList.add('hidden');\r\n    resultsContainer.classList.add('hidden');\r\n    setStatus(`⏳ Procesando ${title}...`, 'loading');\r\n    \r\n    // Mostrar contenedor con indicador de carga\r\n    loadingContainer.style.display = 'block';\r\n    loadingTitle.textContent = title;\r\n    loadingContent.innerHTML = `\r\n      <div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem;gap:1rem;\">\r\n        <div style=\"font-size:3rem;\">⏳</div>\r\n        <div>Analizando con IA...</div>\r\n        <div style=\"width:100%;max-width:300px;\">\r\n          <div style=\"height:4px;background:#334155;border-radius:2px;overflow:hidden;\">\r\n            <div style=\"height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);width:100%;animation:shimmer 1.5s infinite;\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <style>\r\n          @keyframes shimmer {\r\n            0% { transform: translateX(-100%); }\r\n            100% { transform: translateX(100%); }\r\n          }\r\n        </style>\r\n      </div>\r\n    `;\r\n  }\r\n  \r\n  const renderAnalysis = function(){\r\n    loadingContainer.classList.add('hidden');\r\n    llmButtonsContent.classList.add('hidden');\r\n    resultsContainer.classList.remove('hidden');\r\n    \r\n    if (data.response_analysis.success || data.response_analysis.analysis) {\r\n      const title = data.analysis_type;\r\n      \r\n      resultTitle.textContent = title;\r\n      resultContent.innerHTML = `<div style=\"white-space:pre-wrap;line-height:1.6;\">${data.response_analysis.analysis}</div>`;\r\n      resultsContainer.style.display = 'block';\r\n      log(`${title} completado`, 'success');\r\n      showStatus(`✅ ${title} completado`, 'success');\r\n    } else {\r\n      throw new Error(data.error || 'Error desconocido');\r\n    }\r\n  }\r\n  \r\n  setStatus('Cargando análisis…');\r\n  \r\n  console.log('[Dashboard] Análisis cargado', data);\r\n  \r\n  currentJobId = data.job_id;\r\n  \r\n  if(data.inventory){\r\n    loadingEl.classList.add('hidden');\r\n    dashboardEl.classList.remove('hidden');\r\n    renderDashboard();\r\n    setStatus('✅ Análisis cargado correctamente');\r\n  } else {\r\n    summaryEl.innerHTML = `<div style=\"color:#f87171;\">No se encontro análisis del repositorio.</div>`\r\n    setStatus('Sin datos de análisis', 'error');\r\n  }\r\n  \r\n  if(data.show_analysis){\r\n    renderAnalysis();\r\n  }\r\n  \r\n  //---------------------------------------------------\r\n  // Attach click event to buttons\r\n  //---------------------------------------------------\r\n  if (backBtn) {\r\n    console.log('Botón backBtn encontrado');\r\n    backBtn.addEventListener('click', () => {\r\n        console.log('Click detectado en backBtn');\r\n        // Check if we're in production environment\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[volver]\"]');\r\n    \r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón backBtn');\r\n  }\r\n  \r\n  if (reloadBtn) {\r\n    console.log('Botón reloadBtn encontrado');\r\n    reloadBtn.addEventListener('click', () => {\r\n        console.log('Click detectado en reloadBtn');\r\n        // Check if we're in production environment\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[recargar]\"]');\r\n    \r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón reloadBtn');\r\n  }\r\n  \r\n  if (downloadBtn) {\r\n    console.log('Botón downloadBtn encontrado');\r\n    downloadBtn.addEventListener('click', () => {\r\n        console.log('Click detectado en downloadBtn');\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[submit]\"]');\r\n\r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón downloadBtn');\r\n  }\r\n  \r\n  document.querySelectorAll('.analyze-btn').forEach(btn => {\r\n    btn.addEventListener('click', (e) => {\r\n      console.log('Click detectado en analyzeBtn');\r\n      const analysisType = e.target.getAttribute('data-analysis');\r\n      const titleMap = {\r\n        'health': '\uD83D\uDC8A Salud del Inventario',\r\n        'duplicates': '\uD83D\uDD00 Análisis de Duplicados',\r\n        'orphans': '\uD83D\uDC64 Aplicaciones Huérfanas',\r\n        'dependencies': '\uD83D\uDD17 Análisis de Dependencias',\r\n        'recommendations': '\uD83D\uDCA1 Recomendaciones',\r\n        'consolidation': '\uD83D\uDCCB Plan de Consolidación'\r\n      };\r\n      iniciarCargaAnalisis(titleMap[analysisType]);\r\n      const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[generarAnalisis]\"]');\r\n  \r\n      if (submitButton) {\r\n        if (typeof data !== 'undefined') {\r\n          data.analysisType = analysisType;\r\n          data.analysisTitle = titleMap[analysisType];\r\n        }\r\n        submitButton.click();\r\n      }\r\n    });\r\n  });\r\n  \r\n  if (closeLlmResultsBtn) {\r\n    console.log('Botón closeLlmResultsBtn encontrado');\r\n    closeLlmResultsBtn.addEventListener('click', (e) => {\r\n        e.preventDefault();\r\n        console.log('Click detectado en closeLlmResultsBtn');\r\n        llmButtonsContent.classList.remove('hidden');\r\n        loadingContainer.classList.add('hidden');\r\n        resultsContainer.classList.add('hidden');\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[analisisClose]\"]');\r\n\r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón migrationBtn');\r\n  }\r\n});","key":"serverSideJavaScript","type":"customjs","scriptName":"Custom Javascript","input":true,"tableView":false,"label":"Server-side JavaScript","validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"data":{"content":"$(document).ready(async function () {\r\n  $('.formio-component-button').hide();\r\n  $('.alerts-status-bar').hide();\r\n  const statusEl = document.getElementById('status');\r\n  const loadingEl = document.getElementById('loading');\r\n  const dashboardEl = document.getElementById('dashboard');\r\n  const backBtn = document.getElementById('backBtn');\r\n  const reloadBtn = document.getElementById('reloadBtn');\r\n  const downloadBtn = document.getElementById('downloadJsonZipBtn');\r\n  const summaryEl = document.getElementById('summary');\r\n  const analyzeBtn = document.getElementById('analyze-btn');\r\n  const resultsContainer = document.getElementById('llm-results-container');\r\n  const loadingContainer = document.getElementById('loading-container');\r\n  const loadingTitle = document.getElementById('llm-loading-title');\r\n  const loadingContent = document.getElementById('llm-loading-content');\r\n  const resultTitle = document.getElementById('llm-results-title');\r\n  const resultContent = document.getElementById('llm-results-content');\r\n  const llmButtonsContent = document.getElementById('llm-button-section');\r\n  const closeLlmResultsBtn = document.getElementById('closeLlmResultsBtn');\r\n  \r\n  let currentJobId = null;\r\n  \r\n  const log = function(msg, type = 'info') {\r\n    const prefix = {\r\n      'info': '\uD83D\uDCCB',\r\n      'success': '✅',\r\n      'error': '❌',\r\n      'warn': '⚠️',\r\n      'loading': '⏳'\r\n    }[type] || '•';\r\n    \r\n    console.log(`${prefix} ${msg}`);\r\n  }\r\n  \r\n  const showStatus = function(msg, type = 'info') {\r\n    const statusEl = document.getElementById('status');\r\n    if (!statusEl) return;\r\n    \r\n    const icons = {\r\n      'info': '\uD83D\uDCCB',\r\n      'success': '✅',\r\n      'error': '❌',\r\n      'warn': '⚠️',\r\n      'loading': '⏳'\r\n    };\r\n    \r\n    statusEl.innerHTML = `<p class=\"${type}\">${icons[type]} ${msg}</p>`;\r\n    statusEl.style.display = 'block';\r\n  }\r\n  \r\n  const clearStatus = function() {\r\n    const statusEl = document.getElementById('status');\r\n    if (statusEl) {\r\n      statusEl.innerHTML = '';\r\n      statusEl.style.display = 'none';\r\n    }\r\n  }\r\n  \r\n  const setStatus = function(msg, type='info'){\r\n    statusEl.textContent = msg;\r\n    statusEl.className = 'status ' + type;\r\n  }\r\n  \r\n  const renderDashboard = function(){\r\n    const inventoryData = data.inventory;\r\n    const summary = inventoryData.summary || {};\r\n    const applications = inventoryData.applications || [];\r\n    const repositories = inventoryData.repositories || [];\r\n    const issues = inventoryData.issues_detected || [];\r\n    \r\n    // ===== RESUMEN EJECUTIVO =====\r\n    if (summaryEl) {\r\n      const metrics = [\r\n        { label: 'Aplicaciones', value: applications.length, emoji: '\uD83D\uDCE6' },\r\n        { label: 'Repositorios', value: repositories.length, emoji: '\uD83D\uDDC2️' },\r\n        { label: 'Problemas', value: issues.length, emoji: '⚠️' },\r\n        { label: 'Índice Salud', value: summary.health_score ? summary.health_score + '%' : 'N/A', emoji: '\uD83D\uDC8A' },\r\n      ];\r\n      \r\n      summaryEl.innerHTML = `\r\n        <h2>\uD83D\uDCCA Resumen del Inventario</h2>\r\n        <div class=\"metrics-grid\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin-top:1rem;\">\r\n          ${metrics.map(m => `\r\n            <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;text-align:center;\">\r\n              <div style=\"font-size:2rem;margin-bottom:0.5rem;\">${m.emoji}</div>\r\n              <div style=\"color:#94a3b8;font-size:0.75rem;margin-bottom:0.5rem;\">${m.label}</div>\r\n              <div style=\"color:#6366f1;font-size:1.5rem;font-weight:bold;\">${m.value}</div>\r\n            </div>\r\n          `).join('')}\r\n        </div>\r\n        ${summary.executive_summary ? `\r\n          <div style=\"margin-top:1.5rem;padding:1rem;background:#0f172a;border-left:4px solid #6366f1;border-radius:4px;\">\r\n            <p style=\"color:#cbd5e1;line-height:1.6;\">${summary.executive_summary}</p>\r\n          </div>\r\n        ` : ''}\r\n      `;\r\n    }\r\n  \r\n  \r\n    // ===== CATÁLOGO DE APLICACIONES =====\r\n    const appsContainer = document.getElementById('applications-container');\r\n    if (appsContainer && applications.length > 0) {\r\n      appsContainer.innerHTML = applications.map(app => `\r\n        <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:1rem;\">\r\n          <h3 style=\"color:#6366f1;margin-bottom:0.5rem;\">${app.name || 'Sin nombre'}</h3>\r\n          <div style=\"color:#94a3b8;font-size:0.85rem;line-height:1.6;\">\r\n            <p><strong>Dueño:</strong> ${app.owner || 'No asignado'}</p>\r\n            <p><strong>Estado:</strong> <span style=\"color:${app.status === 'Active' ? '#10b981' : '#f59e0b'}\">${app.status || 'Desconocido'}</span></p>\r\n            <p><strong>Repositorios:</strong> ${(app.repositories || []).length}</p>\r\n            ${app.version ? `<p><strong>Versión:</strong> ${app.version}</p>` : ''}\r\n            ${app.description ? `<p><strong>Descripción:</strong> ${app.description}</p>` : ''}\r\n          </div>\r\n        </div>\r\n      `).join('');\r\n    }\r\n    \r\n    // ===== TABLA DE REPOSITORIOS =====\r\n    const tbody = document.getElementById('repositories-tbody');\r\n    if (tbody && repositories.length > 0) {\r\n      tbody.innerHTML = repositories.map(repo => `\r\n        <tr style=\"border-bottom:1px solid #334155;\">\r\n          <td style=\"padding:0.5rem;\"><strong>${repo.name || 'N/A'}</strong></td>\r\n          <td style=\"padding:0.5rem;\">${repo.tags ? repo.tags.length : 0}</td>\r\n          <td style=\"padding:0.5rem;font-size:0.85rem;\">${repo.last_commit ? formatDate(repo.last_commit) : 'N/A'}</td>\r\n          <td style=\"padding:0.5rem;\">${repo.owner || 'N/A'}</td>\r\n        </tr>\r\n      `).join('');\r\n    }\r\n  \r\n    // ===== PROBLEMAS DETECTADOS =====\r\n    const issuesContainer = document.getElementById('issues-container');\r\n    if (issuesContainer && issues.length > 0) {\r\n      issuesContainer.innerHTML = issues.map(issue => {\r\n        const colorMap = {\r\n          'critical': '#ef4444',\r\n          'high': '#f59e0b',\r\n          'medium': '#eab308',\r\n          'low': '#10b981'\r\n        };\r\n        const color = colorMap[issue.severity] || '#94a3b8';\r\n        return `\r\n          <div style=\"background:#0f172a;border-left:4px solid ${color};border-radius:4px;padding:1rem;color:#cbd5e1;\">\r\n            <strong style=\"color:${color};text-transform:uppercase;font-size:0.85rem;\">${issue.severity || 'INFO'}</strong>\r\n            <p style=\"margin-top:0.5rem;margin-bottom:0;\">${issue.message || 'Problema detectado'}</p>\r\n            ${issue.details ? `<p style=\"margin-top:0.5rem;color:#94a3b8;font-size:0.85rem;\">${issue.details}</p>` : ''}\r\n          </div>\r\n        `;\r\n      }).join('');\r\n    }\r\n  }\r\n  \r\n  const iniciarCargaAnalisis = function(title){\r\n    loadingContainer.classList.remove('hidden');\r\n    llmButtonsContent.classList.add('hidden');\r\n    resultsContainer.classList.add('hidden');\r\n    setStatus(`⏳ Procesando ${title}...`, 'loading');\r\n    \r\n    // Mostrar contenedor con indicador de carga\r\n    loadingContainer.style.display = 'block';\r\n    loadingTitle.textContent = title;\r\n    loadingContent.innerHTML = `\r\n      <div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem;gap:1rem;\">\r\n        <div style=\"font-size:3rem;\">⏳</div>\r\n        <div>Analizando con IA...</div>\r\n        <div style=\"width:100%;max-width:300px;\">\r\n          <div style=\"height:4px;background:#334155;border-radius:2px;overflow:hidden;\">\r\n            <div style=\"height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);width:100%;animation:shimmer 1.5s infinite;\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <style>\r\n          @keyframes shimmer {\r\n            0% { transform: translateX(-100%); }\r\n            100% { transform: translateX(100%); }\r\n          }\r\n        </style>\r\n      </div>\r\n    `;\r\n  }\r\n  \r\n  const renderAnalysis = function(){\r\n    loadingContainer.classList.add('hidden');\r\n    llmButtonsContent.classList.add('hidden');\r\n    resultsContainer.classList.remove('hidden');\r\n    \r\n    if (data.response_analysis.success || data.response_analysis.analysis) {\r\n      const title = data.analysis_type;\r\n      \r\n      resultTitle.textContent = title;\r\n      resultContent.innerHTML = `<div style=\"white-space:pre-wrap;line-height:1.6;\">${data.response_analysis.analysis}</div>`;\r\n      resultsContainer.style.display = 'block';\r\n      log(`${title} completado`, 'success');\r\n      showStatus(`✅ ${title} completado`, 'success');\r\n    } else {\r\n      throw new Error(data.error || 'Error desconocido');\r\n    }\r\n  }\r\n  \r\n  setStatus('Cargando análisis…');\r\n  \r\n  console.log('[Dashboard] Análisis cargado', data);\r\n  \r\n  currentJobId = data.job_id;\r\n  \r\n  if(data.inventory){\r\n    loadingEl.classList.add('hidden');\r\n    dashboardEl.classList.remove('hidden');\r\n    renderDashboard();\r\n    setStatus('✅ Análisis cargado correctamente');\r\n  } else {\r\n    summaryEl.innerHTML = `<div style=\"color:#f87171;\">No se encontro análisis del repositorio.</div>`\r\n    setStatus('Sin datos de análisis', 'error');\r\n  }\r\n  \r\n  if(data.show_analysis){\r\n    renderAnalysis();\r\n  }\r\n  \r\n  //---------------------------------------------------\r\n  // Attach click event to buttons\r\n  //---------------------------------------------------\r\n  if (backBtn) {\r\n    console.log('Botón backBtn encontrado');\r\n    backBtn.addEventListener('click', () => {\r\n        console.log('Click detectado en backBtn');\r\n        // Check if we're in production environment\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[volver]\"]');\r\n    \r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón backBtn');\r\n  }\r\n  \r\n  if (reloadBtn) {\r\n    console.log('Botón reloadBtn encontrado');\r\n    reloadBtn.addEventListener('click', () => {\r\n        console.log('Click detectado en reloadBtn');\r\n        // Check if we're in production environment\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[recargar]\"]');\r\n    \r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón reloadBtn');\r\n  }\r\n  \r\n  if (downloadBtn) {\r\n    console.log('Botón downloadBtn encontrado');\r\n    downloadBtn.addEventListener('click', () => {\r\n        console.log('Click detectado en downloadBtn');\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[submit]\"]');\r\n\r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón downloadBtn');\r\n  }\r\n  \r\n  document.querySelectorAll('.analyze-btn').forEach(btn => {\r\n    btn.addEventListener('click', (e) => {\r\n      console.log('Click detectado en analyzeBtn');\r\n      const analysisType = e.target.getAttribute('data-analysis');\r\n      const titleMap = {\r\n        'health': '\uD83D\uDC8A Salud del Inventario',\r\n        'duplicates': '\uD83D\uDD00 Análisis de Duplicados',\r\n        'orphans': '\uD83D\uDC64 Aplicaciones Huérfanas',\r\n        'dependencies': '\uD83D\uDD17 Análisis de Dependencias',\r\n        'recommendations': '\uD83D\uDCA1 Recomendaciones',\r\n        'consolidation': '\uD83D\uDCCB Plan de Consolidación'\r\n      };\r\n      iniciarCargaAnalisis(titleMap[analysisType]);\r\n      const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[generarAnalisis]\"]');\r\n  \r\n      if (submitButton) {\r\n        if (typeof data !== 'undefined') {\r\n          data.analysisType = analysisType;\r\n          data.analysisTitle = titleMap[analysisType];\r\n        }\r\n        submitButton.click();\r\n      }\r\n    });\r\n  });\r\n  \r\n  if (closeLlmResultsBtn) {\r\n    console.log('Botón closeLlmResultsBtn encontrado');\r\n    closeLlmResultsBtn.addEventListener('click', (e) => {\r\n        e.preventDefault();\r\n        console.log('Click detectado en closeLlmResultsBtn');\r\n        llmButtonsContent.classList.remove('hidden');\r\n        loadingContainer.classList.add('hidden');\r\n        resultsContainer.classList.add('hidden');\r\n        const submitButton = document.querySelector('button[type=\"submit\"][name=\"data[analisisClose]\"]');\r\n\r\n        if (submitButton) {\r\n            submitButton.click();\r\n        }\r\n    });\r\n  } else {\r\n    console.error('No se encontró el botón migrationBtn');\r\n  }\r\n});"},"jsProperties":{"first":false},"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":true,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":true,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"customConditional":"","id":"e0c6zfg"},{"label":"recargar","showValidations":false,"tableView":false,"key":"recargar","type":"button","input":true,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"size":"md","leftIcon":"","rightIcon":"","block":false,"action":"submit","disableOnInvalid":false,"theme":"primary","dataGridLabel":true,"id":"es27tgp"},{"label":"Volver","action":"submit","showValidations":false,"theme":"primary","size":"md","block":false,"leftIcon":"","rightIcon":"","shortcut":"","description":"","tooltip":"","customClass":"","tabindex":"","disableOnInvalid":false,"hidden":false,"autofocus":false,"disabled":false,"tableView":false,"modalEdit":false,"key":"volver","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"button","input":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","errorLabel":"","hideLabel":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget"