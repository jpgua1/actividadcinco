.1.3')\n","x":3210,"y":260,"wires":[["cedc5ad4.347bf8"]]},{"id":"cedc5ad4.347bf8","type":"axetflows-view-action","z":"ba34d5d0.f96208","name":"","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","message":"","x":3370,"y":260,"wires":[]},{"id":"84211abc.5f2998","type":"function","z":"ba34d5d0.f96208","name":"Check Status","func":"if (!msg.submission) {\n    msg.submission = {};\n}\n\nif (msg.statusCode === 200 && msg.payload) {\n    flow.set('install_api_status', '\uD83D\uDFE2 API activa y funcionando');\n    node.warn('✅ API está activa');\n} else {\n    flow.set('install_api_status', '\uD83D\uDD34 API no responde');\n    node.warn('❌ API no responde');\n}\n\nmsg.submission.step1_status = flow.get('install_step1') || '⏳ Pendiente';\nmsg.submission.step2_status = flow.get('install_step2') || '⏳ Pendiente';\nmsg.submission.step3_status = flow.get('install_step3') || '⏳ Pendiente';\nmsg.submission.step4_status = flow.get('install_step4') || '⏳ Pendiente';\nmsg.submission.step5_status = flow.get('install_step5') || '⏳ Pendiente';\nmsg.submission.step6_status = flow.get('install_step6') || '⏳ Pendiente';\nmsg.submission.api_status = flow.get('install_api_status');\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":370,"y":520,"wires":[["cbdd4302.746f2"]]},{"id":"cbdd4302.746f2","type":"http request","z":"ba34d5d0.f96208","name":"GET /health","method":"GET","ret":"obj","url":"http://localhost:8000/health","tls":"","persist":false,"proxy":"","authType":"","x":570,"y":520,"wires":[["5df10824.bcfb98"]]},{"id":"5df10824.bcfb98","type":"function","z":"ba34d5d0.f96208","name":"Process Status","func":"if (!msg.submission) {\n    msg.submission = {};\n}\n\nif (msg.statusCode === 200 && msg.payload) {\n    msg.submission.api_status = '\uD83D\uDFE2 API activa y funcionando';\n    node.warn('✅ API está activa');\n} else {\n    msg.submission.api_status = '\uD83D\uDD34 API no responde';\n    node.warn('❌ API no responde');\n}\n\nreturn msg;","outputs":1,"x":770,"y":520,"wires":[["d2957889.a05be"]]},{"id":"d2957889.a05be","type":"axetflows-view-action","z":"ba34d5d0.f96208","name":"","action":"update","x":970,"y":520,"wires":[]},{"id":"3fea151f.9ed2ca","type":"inject","z":"ba34d5d0.f96208","name":"","topic":"","payload":"","payloadType":"date","repeat":"","crontab":"","once":true,"onceDelay":0.1,"x":190,"y":200,"wires":[["f1cfffa3.da2b3"]]},{"id":"c7a609ba.f802d","type":"comment","z":"ba34d5d0.f96208","name":"1.- Añadir python.tar.gz a internal-storage-files de local y de produccion 2.- Ejecutar Instalación Api","info":"1.- Añadir python.tar.gz a internal-storage-files de local y de produccion\n2.- Ejecutar Instalación Api\n","x":500,"y":140,"wires":[]},{"id":"73617e4.928a28","type":"debug","z":"83a4849d.44c58","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":580,"y":880,"wires":[]},{"id":"3d4aa040.edf3","type":"exec","z":"ba34d5d0.f96208","command":"sudo fuser -k 8000/tcp","addpay":true,"append":"","useSpawn":"false","timer":"","oldrc":false,"name":"","x":440,"y":400,"wires":[["e9c6a164.a8eaf"],["9ff953d2.0007c8"],[]]},{"id":"381bc02a.cd7fa8","type":"inject","z":"ba34d5d0.f96208","name":"","topic":"","payload":"","payloadType":"date","repeat":"","crontab":"","once":false,"onceDelay":0.1,"x":180,"y":400,"wires":[["3d4aa040.edf3"]]},{"id":"9ff953d2.0007c8","type":"debug","z":"ba34d5d0.f96208","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":610,"y":400,"wires":[]},{"id":"e9c6a164.a8eaf","type":"axetflows-view-action","z":"ba34d5d0.f96208","name":null,"action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":null,"messageType":"info","x":630,"y":360,"wires":[]},{"id":"24d4aa6d.ad2066","type":"function","z":"29fbdd7d.36c0.4199.940c.3d96e519b52c","name":"Build request","func":"// NUNCA hardcodees valores: usa env vars y datos en msg\nconst token = msg?.__axetFlowsSecurityContext?.externalIdpUserInfo?.access_token;\nif (!token) {\n    node.error(\"Falta access_token en msg.__axetFlowsSecurityContext.externalIdpUserInfo.access_token\");\n    return null;\n}\n\nconst baseUrl = \"https://axet.nttdata.com\";\n\nmsg.method = \"POST\";\nmsg.url = `${baseUrl}/api/core/v1/assets/search`;\nmsg.headers = {\n    authorization: `Bearer ${token}`,\n    \"content-type\": \"application/json\"\n};\nmsg.payload = { search: {} };\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":130,"y":140,"wires":[["36ba51f1.561136"]]},{"id":"36ba51f1.561136","type":"http request","z":"29fbdd7d.36c0.4199.940c.3d96e519b52c","name":"POST /api/core/v1/assets/search","method":"use","ret":"obj","paytoqs":true,"url":"","tls":"","persist":false,"proxy":"","authType":"","x":380,"y":140,"wires":[["2925ce77.6d53d2"]]},{"id":"2925ce77.6d53d2","type":"function","z":"29fbdd7d.36c0.4199.940c.3d96e519b52c","name":"Pick CORE.applicationId → assetId + save credentials","func":"// Validación de respuesta\nconst data = msg?.payload?.data;\nif (!Array.isArray(data)) {\n    node.error(\"Respuesta inesperada del endpoint (falta payload.data)\");\n    return null;\n}\n\n// Buscar el asset CORE sin hardcodear posiciones\nconst core = data.find(x => String(x.code || \"\").toUpperCase() === \"CORE\" || String(x.displayName || \"\").toLowerCase() === \"core\");\nif (!core) {\n    node.error(\"No se encontró el asset con code/displayName 'CORE'\");\n    return null;\n}\n\nconst assetId = core.id; // lo que pides guardar\nif (!assetId) {\n    node.error(\"El asset CORE no trae applicationId\");\n    return null;\n}\n\nmsg.assetId = assetId;\n\n// ====== LOGS opcionales ======\nnode.warn(\"═══════════════════════════════════════\");\nnode.warn(\"\uD83D\uDCE5 RESPUESTA TALKG (assets/search)\");\nnode.warn(\"═══════════════════════════════════════\");\ntry { node.warn(JSON.stringify(msg.payload, null, 2)); } catch(e) {}\nnode.warn(\"═══════════════════════════════════════\");\n\n// ====== Construir y guardar credenciales sin hardcodear ======\nconst credentials = {\n    bearer_token: msg?.__axetFlowsSecurityContext?.externalIdpUserInfo?.access_token,\n    axet_user_id: msg.axet_user_id,\n    axet_project_id: msg.axet_project_id,\n    okta_id: msg.okta_id,\n    assetId, // ← lo que pediste\n    timestamp: new Date().toISOString(),\n    source: \"TalkG Token API\",\n    token_type: \"session\"\n};\n\n// Guardar en submission y onInitSubmission\nif (!msg.submission) msg.submission = {};\nif (!msg.onInitSubmission) msg.onInitSubmission = {};\nmsg.submission.talkg_credentials = credentials;\nmsg.onInitSubmission.talkg_credentials = credentials;\n\nnode.warn(\"═══════════════════════════════════════\");\nnode.warn(\"\uD83D\uDD11 CREDENCIALES GUARDADAS EN MSG (con assetId)\");\nnode.warn(\"═══════════════════════════════════════\");\n\n// También en msg.credentials y payload de salida (texto)\nmsg.credentials = credentials;\nmsg.payload = JSON.stringify(credentials, null, 2);\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":780,"y":140,"wires":[["217f207e.9fe158"]]},{"id":"217f207e.9fe158","type":"file","z":"29fbdd7d.36c0.4199.940c.3d96e519b52c","name":"Guardar credentials.json","filename":"/internal-storage-files/files/axet_credentials.json","appendNewline":false,"createDir":true,"overwriteFile":"true","encoding":"utf8","x":1150,"y":140,"wires":[["a023c951.52233"]]},{"id":"a023c951.52233","type":"function","z":"29fbdd7d.36c0.4199.940c.3d96e519b52c","name":"Confirmación","func":"node.warn('✅ Credenciales guardadas en: /internal-storage-files/files/axet_credentials.json');\n\nmsg.payload = {\n    success: true,\n    message: 'Credenciales guardadas correctamente',\n    file: '/internal-storage-files/files/axet_credentials.json'\n};\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":1410,"y":140,"wires":[[]]},{"id":"d65edd73.4049e","type":"exec","z":"a9869b3b.b2e9.410c.8ff7.15ce91dcaaab","command":"cd /opt && sudo tar -czf python3.12-compiled.tar.gz python3.12/ && sudo mv python3.12-compiled.tar.gz /internal-storage-files/","addpay":false,"append":"","useSpawn":"false","timer":"","oldrc":false,"name":"","x":650,"y":560,"wires":[["89facd68.2914e8"],["89facd68.2914e8"],["89facd68.2914e8"]]},{"id":"89facd68.2914e8","type":"debug","z":"a9869b3b.b2e9.410c.8ff7.15ce91dcaaab","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","x":460,"y":460,"wires":[]},{"id":"3c2b4cc7.e2baf4","type":"inject","z":"a9869b3b.b2e9.410c.8ff7.15ce91dcaaab","name":"","topic":"","payload":"","payloadType":"date","repeat":"","crontab":"","once":false,"onceDelay":0.1,"x":260,"y":460,"wires":[["d65edd73.4049e"]]},{"id":"4c8857f3.66911","type":"exec","z":"a9869b3b.b2e9.410c.8ff7.15ce91dcaaab","command":"cd /tmp && wget https://www.python.org/ftp/python/3.12.0/Python-3.12.0.tgz && tar -xzf Python-3.12.0.tgz","addpay":false,"append":"","useSpawn":"false","timer":"","oldrc":false,"name":"","x":540,"y":240,"wires":[["9cdccbd9.62f49","936ac086.e8fe8"],["9cdccbd9.62f49"],["9cdccbd9.62f49"]]},{"id":"9cdccbd9.62f49","type":"debug","z":"a9869b3b.b2e9.410c.8ff7.15ce91dcaaab","name":"","active":true,"tosidebar":true,