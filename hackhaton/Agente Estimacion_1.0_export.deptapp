-step1-done","type":"function","z":"tab-main","name":"✅ Step 1 Done","func":"node.warn('✅ [PASO 1/6] Python 3.12 extraído correctamente');\n\nflow.set('install_step1', '✅ Completado');\nflow.set('install_step2', '⏳ En progreso...');\n\nmsg.submission.step1_status = flow.get('install_step1');\nmsg.submission.step2_status = flow.get('install_step2');\n\nreturn msg;","outputs":1,"x":820,"y":200,"wires":[["exec-create-symlinks"]]},{"id":"exec-create-symlinks","type":"exec","z":"tab-main","command":"sudo ln -sf /opt/python3.12/bin/python3.12 /usr/local/bin/python3.12 && sudo ln -sf /opt/python3.12/bin/pip3.12 /usr/local/bin/pip3.12","addpay":false,"append":"","useSpawn":"false","timer":"","name":"🔗 Crear Symlinks","x":1050,"y":200,"wires":[["fn-step2-done"],["debug-error"],["debug-error"]]},{"id":"fn-step2-done","type":"function","z":"tab-main","name":"✅ Step 2 Done","func":"node.warn('✅ [PASO 2/6] Symlinks creados correctamente');\n\nflow.set('install_step2', '✅ Completado');\nflow.set('install_step3', '⏳ En progreso...');\n\nmsg.submission.step2_status = flow.get('install_step2');\nmsg.submission.step3_status = flow.get('install_step3');\n\nreturn msg;","outputs":1,"x":1270,"y":200,"wires":[["exec-verify-python"]]},{"id":"exec-verify-python","type":"exec","z":"tab-main","command":"python3.12 --version && python3.12 -m pip --version","addpay":false,"append":"","useSpawn":"false","timer":"","name":"✅ Verificar Python","x":1500,"y":200,"wires":[["fn-step3-done"],["debug-error"],["debug-error"]]},{"id":"fn-step3-done","type":"function","z":"tab-main","name":"✅ Step 3 Done","func":"node.warn('✅ [PASO 3/6] Python verificado: ' + msg.payload.trim());\n\nconst version = msg.payload.trim().split('\\n')[0];\nflow.set('install_step3', '✅ Completado: ' + version);\nflow.set('install_step4', '⏳ En progreso...');\n\nmsg.submission.step3_status = flow.get('install_step3');\nmsg.submission.step4_status = flow.get('install_step4');\n\nreturn msg;","outputs":1,"x":1720,"y":200,"wires":[["exec-install-poetry"]]},{"id":"exec-install-poetry","type":"exec","z":"tab-main","command":"curl -sSL https://install.python-poetry.org | python3.12 -","addpay":false,"append":"","useSpawn":"false","timer":"","name":"📦 Instalar Poetry","x":1950,"y":200,"wires":[["fn-step4-done"],["debug-error"],["debug-error"]]},{"id":"fn-step4-done","type":"function","z":"tab-main","name":"✅ Step 4 Done","func":"node.warn('✅ [PASO 4/6] Poetry instalado correctamente');\n\nflow.set('install_step4', '✅ Completado');\nflow.set('install_step5', '⏳ En progreso...');\n\nmsg.submission.step4_status = flow.get('install_step4');\nmsg.submission.step5_status = flow.get('install_step5');\n\nreturn msg;","outputs":1,"x":2170,"y":200,"wires":[["exec-poetry-install"]]},{"id":"exec-poetry-install","type":"exec","z":"tab-main","command":"cd /internal-storage-files/files && $HOME/.local/bin/poetry install","addpay":false,"append":"","useSpawn":"false","timer":"","name":"📥 Poetry Install","x":2400,"y":200,"wires":[["fn-step5-done"],["debug-error"],["debug-error"]]},{"id":"fn-step5-done","type":"function","z":"tab-main","name":"✅ Step 5 Done","func":"node.warn('✅ [PASO 5/6] Dependencias instaladas');\n\nconst lines = msg.payload.split('\\n');\nconst installed = lines.filter(l => l.includes('Installing')).length;\n\nflow.set('install_step5', '✅ Completado (' + installed + ' pkgs)');\nflow.set('install_step6', '⏳ En progreso...');\n\nmsg.submission.step5_status = flow.get('install_step5');\nmsg.submission.step6_status = flow.get('install_step6');\n\nreturn msg;","outputs":1,"x":2620,"y":200,"wires":[["exec-start-api"]]},{"id":"exec-start-api","type":"exec","z":"tab-main","command":"mkdir -p /internal-storage-files/logs && cd /internal-storage-files/files && nohup $HOME/.local/bin/poetry run python3.12 -m uvicorn api:app --host 0.0.0.0 --port 8000 --reload > /internal-storage-files/logs/api_output.txt 2>&1 &","addpay":false,"append":"","useSpawn":"false","timer":"","name":"🚀 Arrancar API","x":2850,"y":200,"wires":[["fn-step6-done"],["debug-error"],[]]},{"id":"fn-step6-done","type":"function","z":"tab-main","name":"✅ Step 6 Done","func":"node.warn('✅ [PASO 6/6] API arrancada');\n\nflow.set('install_step6', '✅ Completado');\nflow.set('install_api_status', '🟡 Esperando verificación...');\n\nmsg.submission.step6_status = flow.get('install_step6');\nmsg.submission.api_status = flow.get('install_api_status');\n\nreturn msg;","outputs":1,"x":3070,"y":200,"wires":[["delay-health-check"]]},{"id":"delay-health-check","type":"delay","z":"tab-main","name":"Wait 10s","pauseType":"delay","timeout":"10","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"x":3260,"y":200,"wires":[["http-health-check"]]},{"id":"http-health-check","type":"http request","z":"tab-main","name":"GET /health","method":"GET","ret":"obj","paytoqs":false,"url":"http://localhost:8000/api/health","tls":"","persist":false,"proxy":"","authType":"","x":3430,"y":200,"wires":[["fn-api-ok"]]},{"id":"fn-api-ok","type":"function","z":"tab-main","name":"🎉 API OK","func":"node.warn('🎉 API funcionando correctamente');\n\nif (msg.statusCode === 200) {\n    flow.set('install_api_status', '🟢 API activa y funcionando');\n} else {\n    flow.set('install_api_status', '🔴 API no responde');\n}\n\nmsg.submission.api_status = flow.get('install_api_status');\n\nreturn msg;","outputs":1,"x":3600,"y":200,"wires":[[]]},{"id":"debug-error","type":"debug","z":"tab-main","name":"❌ Error","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":800,"y":300,"wires":[]},{"id":"inject-load-env","type":"inject","z":"tab-config","name":"Load .env","topic":"","payload":"","payloadType":"date","repeat":"","crontab":"","once":true,"onceDelay":0.1,"x":150,"y":100,"wires":[["fn-load-env"]]},{"id":"fn-load-env","type":"function","z":"tab-config","name":"Cargar Configuración Azure","func":"const fs = require('fs');\n\nconst envPath = '/internal-storage-files/files/.env';\n\nnode.warn('═══════════════════════════════════════');\nnode.warn('📂 AZURE GLOBAL SETUP');\nnode.warn('═══════════════════════════════════════');\nnode.warn(`📍 Ruta: ${envPath}`);\n\nif (!fs.existsSync(envPath)) {\n    node.error(`❌ No existe archivo .env en ${envPath}`);\n    node.error('');\n    node.error('Cree el archivo con:');\n    node.error('   AZURE_OPENAI_ENDPOINT=https://axet.nttdata.com/api/llm-enabler/v2/azure/openai/');\n    node.error('   AZURE_OPENAI_DEPLOYMENT=gpt-4.1');\n    node.error('   AZURE_API_VERSION=2024-02-15-preview');\n    return msg;\n}\n\ntry {\n    const envContent = fs.readFileSync(envPath, 'utf8');\n\n    node.warn('');\n    node.warn('📄 Contenido del .env:');\n    node.warn('─────────────────────────────────────────');\n    node.warn(envContent);\n    node.warn('─────────────────────────────────────────');\n\n    const envVars = {};\n    const lines = envContent.split(/\\r?\\n/);\n\n    lines.forEach((line) => {\n        const trimmed = line.trim();\n        if (!trimmed || trimmed.startsWith('#')) return;\n\n        const equalIndex = trimmed.indexOf('=');\n        if (equalIndex === -1) return;\n\n        const key = trimmed.substring(0, equalIndex).trim();\n        let value = trimmed.substring(equalIndex + 1).trim();\n\n        if ((value.startsWith('\"') && value.endsWith('\"')) ||\n            (value.startsWith(\"'\") && value.endsWith(\"'\"))) {\n            value = value.slice(1, -1);\n        }\n\n        envVars[key] = value;\n        node.warn(`   ✓ ${key} = \"${value.substring(0, 60)}${value.length > 60 ? '...' : ''}\"`); \n    });\n\n    const azureConfig = {\n        azure_endpoint: envVars.AZURE_OPENAI_ENDPOINT || '',\n        azure_deployment: envVars.AZURE_OPENAI_DEPLOYMENT || '',\n        api_version: envVars.AZURE_API_VERSION || '2024-02-15-preview'\n    };\n\n    node.warn('');\n    node.warn('🔧 CONFIGURACIÓN AZURE:');\n    node.warn(JSON.stringify(azureConfig, null, 2));\n\n    if (!azureConfig.azure_endpoint || !azureConfig.azure_deployment) {\n        node.error('');\n        node.error('❌ CONFIGURACIÓN INCOMPLETA');\n    } else {\n        global.set('azure_static_config', azureConfig);\n        node.warn('');\n        node.warn('✅ Configuración válida y cacheada');\n    }\n\n    node.warn('═══════════════════════════════════════');\n\n} catch (error) {\n    node.error('❌ Error leyendo .env: ' + error.message);\n}\n\nreturn msg;","outputs":1,"x":400,"y":100,"wires":[["debug-config"]]},{"id":"debug-config","type":"debug","z":"tab-config","name":"Azure Config","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":630,"y":100,"wires":[]},{"id":"comment-info","type":"comment","z":"tab-main","name":"📋 Agente de Estimación y Alcance - Instalación","info":"Este flujo instala y configura el Agente de Estimación:\n\n1. Extraer Python 3.12\n2. Crear Symlinks\n3. Verificar Python\n4. Instalar Poetry\n5. Instalar Dependencias\n6. Arrancar API\n\nEndpoints disponibles:\n- POST /api/preview\n- POST /api/artifact/architecture\n- POST /api/artifact/team\n- POST /api/artifact/epics\n- POST /api/artifact/gantt\n- POST /api/artifact/economics\n- POST /api/artifact/risks\n- POST /api/artifact/prerequisites\n- POST /api/artifact/questions\n- POST /api/artifact/improvements\n- POST /api/artifact/export-all\n- GET /api/health","x":280,"y":100,"wires":[]}]},"configData":{"azureOpenAI":{"endpoint":"${AZURE_OPENAI_ENDPOINT}","deployment":"gpt-4.1","apiVersion":"2024-02-15-preview"},"api":{"port":8000,"host":"0.0.0.0"},"files":{"backend":["api.py","AS_langgraphEnabler.py","requirements.txt","pyproject.toml",".env"],"frontend":["web/index.html","web/app.js","web/style.css"],"outputDirectory":"outputs/"}},"requirements":{"python":">=3.10","packages":["fastapi>=0.104.0","uvicorn>=0.24.0","langchain>=0.1.0","langchain-openai>=0.0.5","openai>=1.6.0","python-docx>=1.1.0","openpyxl>=3.1.2","pydantic>=2.5.0","python-multipart>=0.0.6"]}}
