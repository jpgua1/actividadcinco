er-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":600,"y":200,"wires":[["afd111b3.c9d158"]]},{"id":"cc243211.299af","type":"function","z":"83a4849d.44c58","name":"Dynamic roles - Edit button","func":"\n    const roles =\n    msg.__deptAppsSecurityContext?.globalContext?.deptAppNode?.roles ||\n    msg.__axetFlowsSecurityContext?.globalContext?.deptAppNode?.roles;\n     \n    let options = [];\n     \n    if (roles && roles.length) {\n      for (const role of roles) {\n        options.push({ label: role.name, value: role.code })\n      }\n \n      msg.onInitPopulateFormStructure = {\n        roles: [\n            {\n              label: 'Administrador',\n              value: 'ROLE_ADMIN'\n          },\n          {\n              label: 'Authenticated User',\n              value: 'ROLE_USER'\n          },\n          ...options\n        ]\n      }\n    }\n   \n    return msg;\n    ","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"","finalize":"","x":600,"y":280,"wires":[["cdf7a8ed.f241c8"]]},{"id":"cdf7a8ed.f241c8","type":"function","z":"83a4849d.44c58","name":"Get edit button row id","func":"\n    msg._id = msg.submission.dataGrid.find(row => row.edit === true);\n \n    return msg;\n    ","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"","finalize":"","x":580,"y":320,"wires":[["fa58acc6.9f87d8","fa58acc6.9f87d8"]]},{"id":"f92e25f2.02518","type":"function","z":"83a4849d.44c58","name":"Get delete button row id","func":"\n    msg._id = msg.submission.dataGrid.find(row => row.delete === true);\n \n    return msg;\n    ","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"","finalize":"","x":590,"y":240,"wires":[["753fe236.85032c","753fe236.85032c"]]},{"id":"ac406331.87a898","type":"function","z":"83a4849d.44c58","name":"Dynamic roles - onInitForm action","func":"\n    const roles =\n    msg.__deptAppsSecurityContext?.globalContext?.deptAppNode?.roles ||\n    msg.__axetFlowsSecurityContext?.globalContext?.deptAppNode?.roles;\n     \n    let options = [];\n     \n    if (roles && roles.length) {\n      for (const role of roles) {\n        options.push({ label: role.name, value: role.code })\n      }\n \n      msg.onInitPopulateFormStructure = {\n        roles: [\n            {\n              label: 'Administrador',\n              value: 'ROLE_ADMIN'\n          },\n          {\n              label: 'Authenticated User',\n              value: 'ROLE_USER'\n          },\n          ...options\n        ]\n      }\n    }\n   \n    return msg;\n    ","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"","finalize":"","x":620,"y":360,"wires":[["5171f3bc.dc83cc"]]},{"id":"e7f85147.7e765","type":"function","z":"83a4849d.44c58","name":"Load","func":"const userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\n\n// Cargar settings del usuario específico\nconst userSettings = (global.get(`config_${userId}`) || [{}])[0] || {};\n\nnode.warn(`\uD83D\uDCCB Cargando configuración simplificada para usuario: ${userId}`);\n\n// Mapear SOLO los 3 campos necesarios\nconst formData = {\n    globalContext: userSettings.globalContext || \"\",\n    aiModel: userSettings.aiModel || \"gpt-5\",\n    apiVersion: userSettings.apiVersion || \"2024-02-15-preview\"\n};\n\n// ✅ Asignar los datos al payload para que el formulario los tome\nmsg.payload = msg.payload || {};\nmsg.payload.data = formData;\n\n// También en msg.submission por si axetflows lo necesita\nmsg.submission = formData;\n\nnode.warn(`✅ Formulario precargado con datos del usuario ${userId}`);\nnode.warn(`   Contexto: ${formData.globalContext.substring(0, 40)}...`);\nnode.warn(`   Modelo: ${formData.aiModel}`);\nnode.warn(`   API Version: ${formData.apiVersion}`);\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":470,"y":660,"wires":[["13963301.cb9dcd"]]},{"id":"787919f7.233db","type":"inject","z":"83a4849d.44c58","name":"","topic":"","payload":"","payloadType":"date","repeat":"","crontab":"","once":true,"onceDelay":0.1,"x":250,"y":860,"wires":[["40b393bf.24760c"]]},{"id":"40b393bf.24760c","type":"function","z":"83a4849d.44c58","name":"Global","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: \"Azure Global Setup - SOLO ENDPOINT Y DEPLOYMENT\"\n// ═══════════════════════════════════════════════════════════════\n\nconst fs = require('fs');\n\n// ⚠️ LIMPIAR CACHE ANTERIOR (TEMPORAL)\nglobal.set('azure_static_config', null);\nnode.warn('\uD83D\uDDD1️  Cache limpiado');\n\n// ═══════════════════════════════════════════════════════════════\n// \uD83D\uDCC4 CARGAR CONFIGURACIÓN DESDE .env\n// ═══════════════════════════════════════════════════════════════\n\nconst envPath = '/internal-storage-files/files/.env';\n\nnode.warn('═══════════════════════════════════════');\nnode.warn('\uD83D\uDCC2 AZURE GLOBAL SETUP');\nnode.warn('═══════════════════════════════════════');\nnode.warn(`\uD83D\uDCCD Ruta: ${envPath}`);\n\nif (!fs.existsSync(envPath)) {\n    node.error(`❌ No existe archivo .env en ${envPath}`);\n    node.error('');\n    node.error('Cree el archivo con:');\n    node.error('   AZURE_OPENAI_ENDPOINT=https://axet.nttdata.com/api/llm-enabler/v2/azure/openai/48059e0a-9df4-499e-b58d-2858b140af94/');\n    node.error('   AZURE_OPENAI_DEPLOYMENT=gpt-4.1');\n    node.error('   AZURE_API_VERSION=2025-01-01-preview');\n    return msg;\n}\n\ntry {\n    const envContent = fs.readFileSync(envPath, 'utf8');\n\n    node.warn('');\n    node.warn('\uD83D\uDCC4 Contenido del .env:');\n    node.warn('─────────────────────────────────────────');\n    node.warn(envContent);\n    node.warn('─────────────────────────────────────────');\n\n    // Parser mejorado\n    const envVars = {};\n    const lines = envContent.split(/\\r?\\n/);\n\n    lines.forEach((line, index) => {\n        const trimmed = line.trim();\n\n        if (!trimmed || trimmed.startsWith('#')) {\n            return;\n        }\n\n        const equalIndex = trimmed.indexOf('=');\n        if (equalIndex === -1) {\n            return;\n        }\n\n        const key = trimmed.substring(0, equalIndex).trim();\n        let value = trimmed.substring(equalIndex + 1).trim();\n\n        // Eliminar comillas\n        if ((value.startsWith('\"') && value.endsWith('\"')) ||\n            (value.startsWith(\"'\") && value.endsWith(\"'\"))) {\n            value = value.slice(1, -1);\n        }\n\n        envVars[key] = value;\n        node.warn(`   ✓ ${key} = \"${value.substring(0, 60)}${value.length > 60 ? '...' : ''}\"`);\n    });\n\n    // Crear configuración\n    const azureConfig = {\n        azure_endpoint: envVars.AZURE_OPENAI_ENDPOINT || '',\n        azure_deployment: envVars.AZURE_OPENAI_DEPLOYMENT || '',\n        api_version: envVars.AZURE_API_VERSION || '2024-02-15-preview'\n    };\n\n    node.warn('');\n    node.warn('\uD83D\uDD27 CONFIGURACIÓN AZURE:');\n    node.warn(JSON.stringify(azureConfig, null, 2));\n\n    // Validar\n    if (!azureConfig.azure_endpoint || !azureConfig.azure_deployment) {\n        node.error('');\n        node.error('❌ CONFIGURACIÓN INCOMPLETA:');\n        node.error(`   AZURE_OPENAI_ENDPOINT: ${azureConfig.azure_endpoint || '(VACÍO)'}`);\n        node.error(`   AZURE_OPENAI_DEPLOYMENT: ${azureConfig.azure_deployment || '(VACÍO)'}`);\n    } else {\n        // Cachear en global\n        global.set('azure_static_config', azureConfig);\n        node.warn('');\n        node.warn('✅ Configuración válida y cacheada');\n    }\n\n    node.warn('═══════════════════════════════════════');\n\n} catch (error) {\n    node.error('❌ Error leyendo .env: ' + error.message);\n    node.error(error.stack);\n}\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":410,"y":860,"wires":[["73617e4.928a28"]]},{"id":"7587e49b.255d64","type":"function","z":"83a4849d.44c58","name":"Guardar Azure Config","func":"const userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\n\nconst userSettingsKey = `config_${userId}`;\n\n// Traer settings actuales o iniciar array vacío\nmsg.settings = global.get(userSettingsKey) || [{}];\nif (!msg.settings[0]) msg.settings[0] = {};\n\n// ═══════════════════════════════════════════════════════════════\n// 1. VALIDACIÓN SIMPLE\n// ═══════════════════════════════════════════════════════════════\n\nconst v = msg.submission || msg.payload || {};\nconst errors = [];\n\n// Helper para verificar si un valor está vacío\nconst isEmpty = s => !s || (typeof s === 'string' && s.trim().length === 0);\n\n// ⭐ SOLO validar aiModel (es requerido)\nif (isEmpty(v.aiModel)) {\n    errors.push(\"Modelo de IA es requerido\");\n}\n\n// ❌ Bloquear solo si hay errores\nif (errors.length > 0) {\n    node.status({ fill: 'red', shape: 'ring', text: `${errors.length} errores` });\n    node.error('❌ Errores de validación:');\n    errors.forEach(e => node.error(`   • ${e}`));\n\n    msg.payload = { success: false, errors };\n    msg._viewAction = {\n        action: 'update',\n        message: errors[0],\n        messageType: 'danger'\n    };\n    return msg;\n}\n\n// ═══════════════════════════════════════════════════════════════\n// 2. ACTUALIZAR SETTINGS (SOLO 3 CAMPOS)\n// ═══════════════════════════════════════════════════════════════\n\nconst s = msg.settings[0];\n\n// Actualizar los 3 campos\ns.globalContext = v.globalContext || \"\";\ns.aiModel = v.aiModel || \"gpt-5\";\ns.apiVersion = v.apiVersion || \"2024-02-15-preview\";\n\n// Metadata\ns.last_updated = new Date().toISOString();\ns.updated_by = userId;\n\n// ═══════════════════════════════════════════════════════════════\n// 3. LOGS\n// ═══════════════════════════════════════════════════════════════\n\nnode.warn('═══════════════════════════════════════');\nnode.warn(`✅ CONFIGURACIÓN GUARDADA`);\nnode.warn(`   Usuario: ${userId}`);\nnode.warn('');\nnode.warn('\uD83D\uDCCA VALORES GUARDADOS:');\nnode.warn(`   Contexto: ${s.globalContext.substring(0, 50)}...`);\nnode.warn(`   Modelo: ${s.aiModel}`);\nnode.warn(`   API Version: ${s.apiVersion}`);\nnode.warn('═══════════════════════════════════════');\n\nmsg.payload = {\n    success: true,\n    message: `✅ Configuración guardada correctamente`\n};\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `Guardado: ${s.aiModel}`\n});\n\n// Delay mínimo para feedback visual\nsetTimeout(() => {\n    node.send(msg);\n}, 100);\n\nreturn null; // No enviar inmediatamente\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":680,"y":600,"wires":[["e3565fac.e10db8"]]},{"id":"e3565fac.e10db8","type":"axetflows-db-persist","z":"83a4849d.44c58","name":"Persistir Azure Config","dbName":"azure_settings","dbNameIsBlockByAutogeneration":false,"property":"settings","propertyType":"msg","x":920,"y":600,"wires":[["c57722a7.882e6"]]},{"id":"c57722a7.882e6","type":"axetflows-db-flush","z":"83a4849d.44c58","name":"Flush Azure Config","dbName":"azure_settings","flushById":false,"dbNameIsBlockByAutogeneration":false,"x":1140,"y":600,"wires":[["322ea028.ed6d6"]]},{"id":"322ea028.ed6d6","type":"function","z":"83a4849d.44c58","name":"Publicar en Global","func":"const userId = msg.__axetFlowsSecurityContext?.login || 'default_user';\nconst userSettingsKey = `config_${userId}`;\n\n// ✅ Guardar en global DESPUÉS de persistencia\nglobal.set(userSettingsKey, msg.settings);\n\nconst s = msg.settings[0];\n\n// Publicar SOLO los 3 campos necesarios para consumo directo\nconst userVars = [\n    ['globalContext', s.globalContext],\n    ['aiModel', s.aiModel],\n    ['apiVersion', s.apiVersion]\n];\n\nuserVars.forEach(([key, value]) => {\n    global.set(`${key}_${userId}`, value);\n});\n\nnode.warn('═══════════════════════════════════════');\nnode.warn(`✅ CONFIGURACIÓN PUBLICADA EN GLOBAL`);\nnode.warn(`   Usuario: ${userId}`);\nnode.warn(`   Variables publicadas: ${userVars.length}`);\nnode.warn('');\nnode.warn('\uD83D\uDCCA VALORES GLOBALES:');\nnode.warn(`   globalContext_${userId}: ${s.globalContext.substring(0, 40)}...`);\nnode.warn(`   aiModel_${userId}: ${s.aiModel}`);\nnode.warn(`   apiVersion_${userId}: ${s.apiVersion}`);\nnode.warn('═══════════════════════════════════════');\n\nnode.status({ fill: 'green', shape: 'dot', text: 'Configuración guardada' });\n\nmsg._viewAction = {\n    action: 'update',\n    message: '✅ Configuración guardada',\n    messageType: 'success'\n};\n\nreturn msg;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":1360,"y":600,"wires":[["e74b7a20.3dbaa"]]},{"id":"e74b7a20.3dbaa","type":"function","z":"83a4849d.44c58","name":"Aplicar Setup","func":"// ═══════════════════════════════════════════════════════════════\n// Nodo: Aplicar setup global Azure\n// ═══════════════════════════════════════════════════════════════\n\nconst userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\n\nconst cfg = (global.get(`azure_settings_${userId}`) || [{}])[0];\n\nnode.warn(`\uD83D\uDD04 Setup Azure aplicado para usuario: ${userId}`);\nnode.warn(`   LLM Model: ${cfg.azure_llm_model || 'no configurado'}`);\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":1550,"y":600,"wires":[["45b8d2ea.1f4c24","629a2a6a.0726f4"]]},{"id":"d6413206.72c3d8","type":"function","z":"83a4849d.44c58","name":"Reset Azure Config","func":"const userId = msg.__axetFlowsSecurityContext?.login ||\n    msg.__axetFlowsSecurityContext?.login ||\n    msg.req?.user?.id ||\n    \"default_user\";\n\nconst userSettingsKey = `config_${userId}`;\n\nmsg.settings = global.get(userSettingsKey) || [{}];\nif (!msg.settings[0]) msg.settings[0] = {};\n\nconst s = msg.settings[0];\n\n// Resetear a valores por defecto (SOLO 3 CAMPOS)\ns.globalContext = \"\";\ns.aiModel = \"gpt-5\";\ns.apiVersion = \"2024-02-15-preview\";\ns.last_updated = new Date().toISOString();\ns.updated_by = userId;\n\nnode.warn(`\uD83D\uDD04 Configuración resetada para usuario ${userId}`);\n\nmsg.payload = {\n    success: true,\n    message: \"\uD83D\uDD04 Configuración restablecida a valores por defecto\"\n};\n\nnode.status({ fill: 'yellow', shape: 'ring', text: 'Reseteando...' });\n\nsetTimeout(() => {\n    node.send(msg);\n}, 100);\n\nreturn null;\n","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n","x":670,"y":540,"wires":[["e3565fac.e10db8"]]},{"id":"45b8d2ea.1f4c24","type":"debug","z":"83a4849d.44c58","name":"","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","x":1420,"y":720,"wires":[]},{"id":"13963301.cb9dcd","type":"axetflows-view-action","z":"83a4849d.44c58","name":"","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":1110,"y":680,"wires":[]},{"id":"629a2a6a.0726f4","type":"delay","z":"83a4849d.44c58","name":"","pauseType":"delay","timeout":"2","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"x":1200,"y":640,"wires":[["13963301.cb9dcd"]]},{"id":"31d1a3b9.555b74","type":"axetflows-form","z":"ba34d5d0.f96208","name":"\uD83D\uDE80 Instalación API","formStructure":{"display":"form","components":[{"type":"textfield","key":"step1_status","label":"\uD83D\uDCE6 Paso 1: Extraer Python","disabled":true,"defaul